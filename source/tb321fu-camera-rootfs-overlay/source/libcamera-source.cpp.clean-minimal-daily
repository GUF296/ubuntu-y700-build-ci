struct handle_owner {
	struct spa_handle handle;
	std::unique_ptr<struct impl> state;
};

static_assert(offsetof(struct handle_owner, handle) == 0);

int impl_get_interface(struct spa_handle *handle, const char *type, void **interface)
{
	spa_return_val_if_fail(handle != nullptr, -EINVAL);
	spa_return_val_if_fail(interface != nullptr, -EINVAL);
	auto *owner = reinterpret_cast<struct handle_owner *>(handle);
	auto *impl = owner->state.get();
	spa_return_val_if_fail(impl != nullptr, -EIO);

	if (spa_streq(type, SPA_TYPE_INTERFACE_Node))
		*interface = &impl->node;
	else
		return -ENOENT;

	return 0;
}

static bool impl_provider_ownership_retired(struct impl *impl)
{
	if (impl == nullptr)
		return false;
	std::lock_guard<std::mutex> activity_guard(impl->completion_mutex);
	return impl->callbacks_inflight == 0 && impl->processes_inflight == 0 &&
		!impl->source_registered.load(std::memory_order_acquire) &&
		!impl->camera_started.load(std::memory_order_acquire) &&
		!impl->signal_connected.load(std::memory_order_acquire) &&
		impl->source_fd.load(std::memory_order_acquire) < 0;
}

/* Clear is terminal from PipeWire's point of view, but a provider is allowed
 * to finish an already-running callback asynchronously.  Keep the complete
 * implementation owner in a process-lifetime reaper until every provider
 * object has been retired; dropping the unique_ptr here would turn a late
 * libcamera callback into a use-after-free. */
class impl_quarantine_reaper {
public:
	static impl_quarantine_reaper &instance()
	{
		/* Deliberately leaked so a broken provider cannot make process shutdown
		 * join an infinite retry thread.  The NODELETE producer keeps this code
		 * mapped while queued implementations are being retired. */
		static auto *reaper = new impl_quarantine_reaper();
		return *reaper;
	}

	void enqueue(std::shared_ptr<struct impl> state)
	{
		if (!state)
			return;
		{
			std::lock_guard<std::mutex> lock(mutex_);
			pending_.push_back({ std::move(state), 0,
				std::chrono::steady_clock::now() });
			if (!worker_.joinable())
				worker_ = std::thread([this] { run(); });
		}
		condition_.notify_one();
	}

private:
	struct entry {
		std::shared_ptr<struct impl> state;
		unsigned int attempts;
		std::chrono::steady_clock::time_point retry_at;
	};

	std::mutex mutex_;
	std::condition_variable condition_;
	std::deque<entry> pending_;
	std::thread worker_;

	void run()
	{
		for (;;) {
			entry item;
			{
				std::unique_lock<std::mutex> lock(mutex_);
				while (pending_.empty())
					condition_.wait(lock);
				auto next = std::min_element(pending_.begin(), pending_.end(),
					[](const entry &left, const entry &right) {
						return left.retry_at < right.retry_at;
					});
				const auto now = std::chrono::steady_clock::now();
				if (next->retry_at > now) {
					condition_.wait_until(lock, next->retry_at);
					continue;
				}
				item = std::move(*next);
				pending_.erase(next);
			}

			const int stop_res = item.state->stop(true);
			(void)stop_res;
			if (impl_provider_ownership_retired(item.state.get()) &&
				finalize_impl_resources(item.state.get()) == 0)
				continue;

			/* A provider failure is retried with a bounded backoff.  There is no
			 * unsafe timeout-based free: an unretirable owner remains queued until
			 * a later callback/reset makes its ownership proof complete. */
			item.attempts = std::min(item.attempts + 1, 120u);
			const auto delay = std::chrono::milliseconds(
				std::min<unsigned int>(30000u, 100u << std::min(item.attempts, 8u)));
			item.retry_at = std::chrono::steady_clock::now() + delay;
			{
				std::lock_guard<std::mutex> lock(mutex_);
				pending_.push_back(std::move(item));
			}
			condition_.notify_one();
		}
	}
};

static int finalize_impl_resources(struct impl *impl)
{
	if (impl == nullptr)
		return -EINVAL;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	struct port *port = &impl->out_ports[0];
	if (port->n_buffers > 0) {
		std::lock_guard<std::mutex> buffer_guard(impl->buffer_mutex);
		const int clear_res = clear_buffers_locked(port);
		if (clear_res < 0)
			return clear_res;
	}
	if (!impl->requestPool.empty() || impl->allocator.allocated()) {
		const int free_res = freeBuffers(impl, port);
		if (free_res < 0)
			return free_res;
	}
	if (impl->requestPool.size() != 0 || impl->allocator.allocated())
		return -EBUSY;

	/* spa_libcamera_close() deliberately refuses a configured port.  Detach the
	 * public marker only for this terminal call and restore it if release fails. */
	auto old_format = std::move(port->current_format);
	const int close_res = spa_libcamera_close(impl);
	if (close_res < 0) {
		port->current_format = std::move(old_format);
		return close_res;
	}
	old_format.reset();
	impl->config.reset();
	impl->rollback_config.reset();
	port->streamConfig = {};
	port->rate = defaultClockRate;
	port->buffers_blocks = 1;
	impl->format_transaction_failed = false;
	impl->completion_error.store(0, std::memory_order_release);
	y700_display_rotation_cleanup(impl);
	return 0;
}

int impl_clear(struct spa_handle *handle)
{
	if (handle == nullptr)
		return -EINVAL;
	auto *owner = reinterpret_cast<struct handle_owner *>(handle);
	std::unique_ptr<struct impl> state = std::move(owner->state);
	std::shared_ptr<struct impl> shared_state(std::move(state));
	auto *impl = shared_state.get();
	if (impl == nullptr) {
		std::destroy_at(owner);
		return 0;
	}
	std::unique_lock<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	auto log_clear_error = [impl](const char *operation, int error) {
		if (error < 0 && impl->log)
			spa_log_error(impl->log, "camera clear %s failed: %s",
				operation, spa_strerror(error));
	};
	int stop_res = impl->stop(true);
	log_clear_error("stop", stop_res);
	if (stop_res < 0) {
		/* The production PipeWire loader frees the handle regardless of this
		 * method's return value.  Retry ownership retirement instead of exposing a
		 * fake retry contract to a caller that cannot honour it. */
		stop_res = impl->stop(true);
		log_clear_error("stop retry", stop_res);
	}
	if (!impl_provider_ownership_retired(impl)) {
		if (impl->log)
			spa_log_error(impl->log,
				"camera clear quarantined provider-owned state after stop failure");
		lifecycle_guard.unlock();
		impl_quarantine_reaper::instance().enqueue(std::move(shared_state));
		std::destroy_at(owner);
		return 0;
	}
	const int final_res = finalize_impl_resources(impl);
	log_clear_error("terminal resource release", final_res);
	lifecycle_guard.unlock();
	std::destroy_at(owner);
	if (final_res < 0)
		impl_quarantine_reaper::instance().enqueue(std::move(shared_state));
	return 0;
}

impl::impl(spa_log *log, spa_loop *data_loop, spa_system *system,
	   std::shared_ptr<CameraManager> manager, std::shared_ptr<Camera> camera,
	   std::unique_ptr<CameraConfiguration> config)
	: log(log),
	  data_loop(data_loop),
	  system(system),
	  out_ports{{this}},
	  manager(std::move(manager)),
	  camera(std::move(camera)),
	  config(std::move(config)),
	  allocator(this->camera)
{
	libcamera_log_topic_init(log);
	source.fd = -1;

	spa_hook_list_init(&hooks);

	node.iface = SPA_INTERFACE_INIT(
			SPA_TYPE_INTERFACE_Node,
			SPA_VERSION_NODE,
			&impl_node, this);

	params[NODE_PropInfo] = SPA_PARAM_INFO(SPA_PARAM_PropInfo, SPA_PARAM_INFO_READ);
	params[NODE_Props] = SPA_PARAM_INFO(SPA_PARAM_Props, SPA_PARAM_INFO_WRITE);
	params[NODE_EnumFormat] = SPA_PARAM_INFO(SPA_PARAM_EnumFormat, SPA_PARAM_INFO_READ);
	params[NODE_Format] = SPA_PARAM_INFO(SPA_PARAM_Format, SPA_PARAM_INFO_WRITE);

	info.max_output_ports = 1;
	info.flags = SPA_NODE_FLAG_RT;
	info.params = params;
	info.n_params = N_NODE_PARAMS;

	latency[SPA_DIRECTION_INPUT] = SPA_LATENCY_INFO(SPA_DIRECTION_INPUT);
	latency[SPA_DIRECTION_OUTPUT] = SPA_LATENCY_INFO(SPA_DIRECTION_OUTPUT);
}

size_t
impl_get_size(const struct spa_handle_factory *factory,
	      const struct spa_dict *params)
{
	return sizeof(struct handle_owner);
}

int
impl_init(const struct spa_handle_factory *factory,
	  struct spa_handle *handle,
	  const struct spa_dict *info,
	  const struct spa_support *support,
	  uint32_t n_support)
{
	int res;

	spa_return_val_if_fail(factory != nullptr, -EINVAL);
	spa_return_val_if_fail(handle != nullptr, -EINVAL);

	auto log = static_cast<spa_log *>(spa_support_find(support, n_support, SPA_TYPE_INTERFACE_Log));
	auto data_loop = static_cast<spa_loop *>(spa_support_find(support, n_support, SPA_TYPE_INTERFACE_DataLoop));
	auto system = static_cast<spa_system *>(spa_support_find(support, n_support, SPA_TYPE_INTERFACE_System));

	if (!data_loop) {
		spa_log_error(log, "a data_loop is needed");
		return -EINVAL;
	}

	if (!system) {
		spa_log_error(log, "a system is needed");
		return -EINVAL;
	}

	auto manager = libcamera_manager_acquire(res);
	if (!manager) {
		spa_log_error(log, "can't start camera manager: %s", spa_strerror(res));
		return res;
	}

	const char *device_id = info
		? spa_dict_lookup(info, SPA_KEY_API_LIBCAMERA_PATH)
		: nullptr;

	auto camera = device_id ? manager->get(device_id) : nullptr;
	if (!camera) {
		spa_log_error(log, "unknown camera id: %s", device_id ? device_id : "(unspecified)");
		return -ENOENT;
	}

	auto config = camera->generateConfiguration({ libcamera::StreamRole::VideoRecording });
	if (!config) {
		spa_log_error(log, "cannot generate configuration for camera");
		return -EINVAL;
	}

	try {
		auto state = std::make_unique<struct impl>(
			log, data_loop, system,
			std::move(manager), std::move(camera), std::move(config));
		new (handle) handle_owner{
			{ SPA_VERSION_HANDLE, impl_get_interface, impl_clear },
			std::move(state),
		};
	} catch (const std::bad_alloc &) {
		return -ENOMEM;
	} catch (...) {
		return -EIO;
	}

	return 0;
}

const struct spa_interface_info impl_interfaces[] = {
	{SPA_TYPE_INTERFACE_Node,},
};

int impl_enum_interface_info(const struct spa_handle_factory *factory,
			     const struct spa_interface_info **info,
			     uint32_t *index)
{
	spa_return_val_if_fail(factory != nullptr, -EINVAL);
	spa_return_val_if_fail(info != nullptr, -EINVAL);
	spa_return_val_if_fail(index != nullptr, -EINVAL);

	if (*index >= SPA_N_ELEMENTS(impl_interfaces))
		return 0;

	*info = &impl_interfaces[(*index)++];
	return 1;
}

