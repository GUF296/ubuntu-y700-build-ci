int score_size(const Size &a, const Size &b)
{
	const uint64_t x = a.width >= b.width ?
		static_cast<uint64_t>(a.width) - b.width :
		static_cast<uint64_t>(b.width) - a.width;
	const uint64_t y = a.height >= b.height ?
		static_cast<uint64_t>(a.height) - b.height :
		static_cast<uint64_t>(b.height) - a.height;
	const unsigned __int128 score = static_cast<unsigned __int128>(x) * x +
		static_cast<unsigned __int128>(y) * y;
	return score > static_cast<unsigned __int128>(std::numeric_limits<int>::max())
		? std::numeric_limits<int>::max() : static_cast<int>(score);
}

static constexpr struct spa_fraction defaultFramerate = { 30, 1 };
static constexpr struct spa_fraction defaultClockRate = { 1, 30 };

static bool framerate_valid(const struct spa_fraction *framerate)
{
	/* Keep the pacing calculation bounded.  Normal camera rates are far below
	 * this limit; rejecting pathological POD values avoids floating-point
	 * overflow and divide-by-zero behavior in the DLL clock path. */
	return framerate != nullptr && framerate->num > 0 && framerate->denom > 0 &&
		framerate->num <= 1000000 && framerate->denom <= 1000000;
}

static bool framerate_variable(const struct spa_fraction *framerate)
{
	/* SPA defines 0/1 as an explicitly variable frame rate.  It is a valid
	 * negotiated value, but the local pacing clock still needs a bounded basis. */
	return framerate != nullptr && framerate->num == 0 && framerate->denom == 1;
}

static bool framerate_request_valid(const struct spa_fraction *framerate)
{
	return framerate_variable(framerate) || framerate_valid(framerate);
}

static struct spa_fraction normalized_framerate(const struct spa_fraction *framerate)
{
	struct spa_fraction result = framerate_valid(framerate)
		? *framerate : defaultFramerate;
	const uint32_t divisor = std::gcd(result.num, result.denom);
	result.num /= divisor;
	result.denom /= divisor;
	return result;
}

static struct spa_fraction framerate_to_clock_rate(
		const struct spa_fraction &framerate)
{
	const struct spa_fraction normalized = normalized_framerate(&framerate);
	return SPA_FRACTION(normalized.denom, normalized.num);
}

static bool fractions_equal(const struct spa_fraction &a,
		const struct spa_fraction &b)
{
	if (!framerate_request_valid(&a) || !framerate_request_valid(&b))
		return false;
	const struct spa_fraction left = normalized_framerate(&a);
	const struct spa_fraction right = normalized_framerate(&b);
	return left.num == right.num && left.denom == right.denom;
}

static bool checked_next_timestamp(uint64_t current,
		const struct spa_fraction &clock_rate,
		double correction, uint64_t *next)
{
	if (next == nullptr || clock_rate.num == 0 || clock_rate.denom == 0 ||
		!std::isfinite(correction) || correction <= 0.0)
		return false;
	const long double delta = static_cast<long double>(clock_rate.num) *
		static_cast<long double>(SPA_NSEC_PER_SEC) /
		static_cast<long double>(clock_rate.denom) *
		static_cast<long double>(correction);
	if (!std::isfinite(delta) || delta < 1.0L ||
		delta > static_cast<long double>(std::numeric_limits<uint64_t>::max()))
		return false;
	const uint64_t increment = static_cast<uint64_t>(delta);
	if (current > std::numeric_limits<uint64_t>::max() - increment)
		return false;
	*next = current + increment;
	return true;
}

[[nodiscard]]
spa_video_colorimetry
color_space_to_colorimetry(const libcamera::ColorSpace& colorspace)
{
	spa_video_colorimetry res = {};

	switch (colorspace.range) {
	case ColorSpace::Range::Full:
		res.range = SPA_VIDEO_COLOR_RANGE_0_255;
		break;
	case ColorSpace::Range::Limited:
		res.range = SPA_VIDEO_COLOR_RANGE_16_235;
		break;
	}

	switch (colorspace.ycbcrEncoding) {
	case ColorSpace::YcbcrEncoding::None:
		res.matrix = SPA_VIDEO_COLOR_MATRIX_RGB;
		break;
	case ColorSpace::YcbcrEncoding::Rec601:
		res.matrix = SPA_VIDEO_COLOR_MATRIX_BT601;
		break;
	case ColorSpace::YcbcrEncoding::Rec709:
		res.matrix = SPA_VIDEO_COLOR_MATRIX_BT709;
		break;
	case ColorSpace::YcbcrEncoding::Rec2020:
		res.matrix = SPA_VIDEO_COLOR_MATRIX_BT2020;
		break;
	}

	switch (colorspace.transferFunction) {
	case ColorSpace::TransferFunction::Linear:
		res.transfer = SPA_VIDEO_TRANSFER_GAMMA10;
		break;
	case ColorSpace::TransferFunction::Srgb:
		res.transfer = SPA_VIDEO_TRANSFER_SRGB;
		break;
	case ColorSpace::TransferFunction::Rec709:
		res.transfer = SPA_VIDEO_TRANSFER_BT709;
		break;
	}

	switch (colorspace.primaries) {
	case ColorSpace::Primaries::Raw:
		res.primaries = SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN;
		break;
	case ColorSpace::Primaries::Smpte170m:
		res.primaries = SPA_VIDEO_COLOR_PRIMARIES_SMPTE170M;
		break;
	case ColorSpace::Primaries::Rec709:
		res.primaries = SPA_VIDEO_COLOR_PRIMARIES_BT709;
		break;
	case ColorSpace::Primaries::Rec2020:
		res.primaries = SPA_VIDEO_COLOR_PRIMARIES_BT2020;
		break;
	}

	return res;
}

static int colorimetry_to_color_space(const struct spa_video_info_raw &raw,
		std::optional<libcamera::ColorSpace> *colorspace)
{
	if (colorspace == nullptr)
		return -EINVAL;
	colorspace->reset();
	if (raw.color_range == SPA_VIDEO_COLOR_RANGE_UNKNOWN &&
		raw.color_matrix == SPA_VIDEO_COLOR_MATRIX_UNKNOWN &&
		raw.transfer_function == SPA_VIDEO_TRANSFER_UNKNOWN &&
		raw.color_primaries == SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN)
		return 0;

	ColorSpace::Range range;
	switch (raw.color_range) {
	case SPA_VIDEO_COLOR_RANGE_0_255:
		range = ColorSpace::Range::Full;
		break;
	case SPA_VIDEO_COLOR_RANGE_16_235:
		range = ColorSpace::Range::Limited;
		break;
	default:
		return -ENOTSUP;
	}

	ColorSpace::YcbcrEncoding encoding;
	switch (raw.color_matrix) {
	case SPA_VIDEO_COLOR_MATRIX_RGB:
		encoding = ColorSpace::YcbcrEncoding::None;
		break;
	case SPA_VIDEO_COLOR_MATRIX_BT601:
		encoding = ColorSpace::YcbcrEncoding::Rec601;
		break;
	case SPA_VIDEO_COLOR_MATRIX_BT709:
		encoding = ColorSpace::YcbcrEncoding::Rec709;
		break;
	case SPA_VIDEO_COLOR_MATRIX_BT2020:
		encoding = ColorSpace::YcbcrEncoding::Rec2020;
		break;
	default:
		return -ENOTSUP;
	}

	ColorSpace::TransferFunction transfer;
	switch (raw.transfer_function) {
	case SPA_VIDEO_TRANSFER_GAMMA10:
		transfer = ColorSpace::TransferFunction::Linear;
		break;
	case SPA_VIDEO_TRANSFER_SRGB:
		transfer = ColorSpace::TransferFunction::Srgb;
		break;
	case SPA_VIDEO_TRANSFER_BT709:
		transfer = ColorSpace::TransferFunction::Rec709;
		break;
	default:
		return -ENOTSUP;
	}

	ColorSpace::Primaries primaries;
	switch (raw.color_primaries) {
	case SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN:
		primaries = ColorSpace::Primaries::Raw;
		break;
	case SPA_VIDEO_COLOR_PRIMARIES_SMPTE170M:
		primaries = ColorSpace::Primaries::Smpte170m;
		break;
	case SPA_VIDEO_COLOR_PRIMARIES_BT709:
		primaries = ColorSpace::Primaries::Rec709;
		break;
	case SPA_VIDEO_COLOR_PRIMARIES_BT2020:
		primaries = ColorSpace::Primaries::Rec2020;
		break;
	default:
		return -ENOTSUP;
	}

	*colorspace = ColorSpace(primaries, transfer, encoding, range);
	return 0;
}

static void publish_color_space(const std::optional<libcamera::ColorSpace> &colorspace,
		struct spa_video_info_raw *raw)
{
	if (raw == nullptr)
		return;
	if (!colorspace) {
		raw->color_range = SPA_VIDEO_COLOR_RANGE_UNKNOWN;
		raw->color_matrix = SPA_VIDEO_COLOR_MATRIX_UNKNOWN;
		raw->transfer_function = SPA_VIDEO_TRANSFER_UNKNOWN;
		raw->color_primaries = SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN;
		return;
	}
	const auto colorimetry = color_space_to_colorimetry(*colorspace);
	raw->color_range = colorimetry.range;
	raw->color_matrix = colorimetry.matrix;
	raw->transfer_function = colorimetry.transfer;
	raw->color_primaries = colorimetry.primaries;
}

static bool raw_colorimetry_equal(const struct spa_video_info_raw &left,
		const struct spa_video_info_raw &right)
{
	return left.color_range == right.color_range &&
		left.color_matrix == right.color_matrix &&
		left.transfer_function == right.transfer_function &&
		left.color_primaries == right.color_primaries;
}

static bool raw_colorimetry_unspecified(const struct spa_video_info_raw &raw)
{
	return raw.color_range == SPA_VIDEO_COLOR_RANGE_UNKNOWN &&
		raw.color_matrix == SPA_VIDEO_COLOR_MATRIX_UNKNOWN &&
		raw.transfer_function == SPA_VIDEO_TRANSFER_UNKNOWN &&
		raw.color_primaries == SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN;
}

int
spa_libcamera_enum_format(struct impl *impl, struct port *port, int seq,
			     uint32_t start, uint32_t num, const struct spa_pod *filter)
{
	if (impl == nullptr || port == nullptr || !impl->camera)
		return -EIO;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	uint8_t buffer[1024];
	struct spa_pod_builder b = { 0 };
	struct spa_pod_frame f[2];
	struct spa_result_node_params result;
	uint32_t count = 0;

	/* A released node may still be queried while PipeWire renegotiates.  Use a
	 * detached configuration for enumeration instead of dereferencing the
	 * cleared live configuration; never publish it as active state. */
	std::unique_ptr<CameraConfiguration> generated;
	const CameraConfiguration *enum_config = impl->config.get();
	if (enum_config == nullptr || enum_config->empty()) {
		generated = impl->camera->generateConfiguration({ StreamRole::VideoRecording });
		enum_config = generated.get();
	}
	if (enum_config == nullptr || enum_config->empty())
		return -EIO;
	const StreamConfiguration& streamConfig = enum_config->at(0);
	const StreamFormats &formats = streamConfig.formats();
	const auto &pixel_formats = formats.pixelformats();

	result.id = SPA_PARAM_EnumFormat;
	result.next = start;

	if (result.next == 0) {
		port->fmt_index = 0;
		port->size_index = 0;
	}
next:
	result.index = result.next++;

next_fmt:
	if (port->fmt_index >= pixel_formats.size())
		return 0;

	auto format = pixel_formats[port->fmt_index];
	spa_log_debug(impl->log, "format: %s", format.toString().c_str());

	const auto *info = video_format_to_info(format);
	if (info == nullptr) {
		spa_log_debug(impl->log, "unknown format");
		port->fmt_index++;
		goto next_fmt;
	}

	const auto& sizes = formats.sizes(format);
	SizeRange sizeRange;
	Size frameSize;

	if (!sizes.empty() && port->size_index <= sizes.size()) {
		if (port->size_index == 0) {
			Size wanted = Size(640, 480);
			int best = std::numeric_limits<int>::max();

			for (const auto& test : sizes) {
				int score = score_size(wanted, test);
				if (score < best) {
					best = score;
					frameSize = test;
				}
			}
		}
		else {
			frameSize = sizes[port->size_index - 1];
		}
	} else if (port->size_index < 1) {
		sizeRange = formats.range(format);
		if (sizeRange.hStep == 0 || sizeRange.vStep == 0) {
			port->size_index = 0;
			port->fmt_index++;
			goto next_fmt;
		}
	} else {
		port->size_index = 0;
		port->fmt_index++;
		goto next_fmt;
	}
	port->size_index++;

	spa_pod_builder_init(&b, buffer, sizeof(buffer));
	spa_pod_builder_push_object(&b, &f[0], SPA_TYPE_OBJECT_Format, SPA_PARAM_EnumFormat);
	spa_pod_builder_add(&b,
			SPA_FORMAT_mediaType,    SPA_POD_Id(info->media_type),
			SPA_FORMAT_mediaSubtype, SPA_POD_Id(info->media_subtype),
			0);

	if (info->media_subtype == SPA_MEDIA_SUBTYPE_raw) {
		spa_pod_builder_prop(&b, SPA_FORMAT_VIDEO_format, 0);
		spa_pod_builder_id(&b, info->format);
	}
	if (info->pix.modifier()) {
		spa_pod_builder_prop(&b, SPA_FORMAT_VIDEO_modifier, 0);
		spa_pod_builder_long(&b, info->pix.modifier());
	}
	spa_pod_builder_prop(&b, SPA_FORMAT_VIDEO_size, 0);

	if (sizeRange.hStep != 0 && sizeRange.vStep != 0) {
		spa_pod_builder_push_choice(&b, &f[1], SPA_CHOICE_Step, 0);
		spa_pod_builder_frame(&b, &f[1]);
		spa_pod_builder_rectangle(&b,
				sizeRange.min.width,
				sizeRange.min.height);
		spa_pod_builder_rectangle(&b,
				sizeRange.min.width,
				sizeRange.min.height);
		spa_pod_builder_rectangle(&b,
				sizeRange.max.width,
				sizeRange.max.height);
		spa_pod_builder_rectangle(&b,
				sizeRange.hStep,
				sizeRange.vStep);
		spa_pod_builder_pop(&b, &f[1]);

	} else {
		spa_pod_builder_rectangle(&b, frameSize.width, frameSize.height);
	}

	/* Keep the advertised contract explicit even when libcamera does not
	 * expose a discrete frame-rate list for the stream.  A negotiated rate is
	 * consumed by spa_libcamera_set_format below. */
	spa_pod_builder_add(&b,
			SPA_FORMAT_VIDEO_framerate,
			SPA_POD_Fraction(&defaultFramerate),
			0);

	if (streamConfig.colorSpace) {
		auto colorimetry = color_space_to_colorimetry(*streamConfig.colorSpace);

		spa_pod_builder_add(&b,
				SPA_FORMAT_VIDEO_colorRange,
				SPA_POD_Id(colorimetry.range),
				SPA_FORMAT_VIDEO_colorMatrix,
				SPA_POD_Id(colorimetry.matrix),
				SPA_FORMAT_VIDEO_transferFunction,
				SPA_POD_Id(colorimetry.transfer),
				SPA_FORMAT_VIDEO_colorPrimaries,
				SPA_POD_Id(colorimetry.primaries), 0);
	}

	const auto *fmt = reinterpret_cast<spa_pod *>(spa_pod_builder_pop(&b, &f[0]));
	if (spa_pod_filter(&b, &result.param, fmt, filter) < 0)
		goto next;

	spa_node_emit_result(&impl->hooks, seq, 0, SPA_RESULT_TYPE_NODE_PARAMS, &result);

	if (++count != num)
		goto next;

	return 0;
}

static int validate_stream_configuration(
		const CameraConfiguration *configuration,
		const struct format_info &info,
		const struct spa_rectangle &requested_size,
		const std::optional<libcamera::ColorSpace> &requested_color_space,
		bool require_configured_state)
{
	if (configuration == nullptr || configuration->size() != 1)
		return -EINVAL;

	const StreamConfiguration &stream = configuration->at(0);
	if (stream.pixelFormat != info.pix ||
		stream.size.width != requested_size.width ||
		stream.size.height != requested_size.height)
		return -EINVAL;
	if (requested_color_space &&
		(!stream.colorSpace || *stream.colorSpace != *requested_color_space))
		return -EINVAL;
	if (require_configured_state &&
		((info.media_subtype == SPA_MEDIA_SUBTYPE_raw && stream.stride == 0) ||
		 stream.frameSize == 0 ||
		 (stream.stride != 0 && stream.frameSize < stream.stride) ||
		 stream.stream() == nullptr ||
		 stream.bufferCount == 0 || stream.bufferCount > MAX_BUFFERS))
		return -EINVAL;

	return 0;
}

int spa_libcamera_set_format(struct impl *impl, struct port *port,
		struct spa_video_info *format, bool try_only)
{
	if (impl == nullptr || port == nullptr || format == nullptr)
		return -EINVAL;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	if (impl->format_transaction_failed || impl->rollback_config != nullptr)
		return impl->completion_error.load(std::memory_order_acquire) < 0
			? impl->completion_error.load(std::memory_order_acquire) : -EIO;
	const struct format_info *info = nullptr;
	uint32_t video_format;
	struct spa_rectangle *size = nullptr;
	struct spa_fraction *framerate = nullptr;
	CameraConfiguration::Status validation;
	std::optional<libcamera::ColorSpace> requested_color_space;

	switch (format->media_subtype) {
	case SPA_MEDIA_SUBTYPE_raw:
		video_format = format->info.raw.format;
		size = &format->info.raw.size;
		framerate = &format->info.raw.framerate;
		break;
	case SPA_MEDIA_SUBTYPE_mjpg:
	case SPA_MEDIA_SUBTYPE_jpeg:
		video_format = SPA_VIDEO_FORMAT_ENCODED;
		size = &format->info.mjpg.size;
		framerate = &format->info.mjpg.framerate;
		break;
	case SPA_MEDIA_SUBTYPE_h264:
		video_format = SPA_VIDEO_FORMAT_ENCODED;
		size = &format->info.h264.size;
		framerate = &format->info.h264.framerate;
		break;
	default:
		video_format = SPA_VIDEO_FORMAT_ENCODED;
		break;
	}

	info = find_format_info_by_media_type(format->media_type,
					      format->media_subtype, video_format);
	if (info == nullptr || size == nullptr || framerate == nullptr) {
		spa_log_error(impl->log, "unknown media type %d %d %d", format->media_type,
			      format->media_subtype, video_format);
		return -EINVAL;
	}
	if (format->media_subtype == SPA_MEDIA_SUBTYPE_raw) {
		const auto &raw = format->info.raw;
		if (raw.flags & ~SPA_VIDEO_FLAG_MODIFIER)
			return -ENOTSUP;
		const bool modifier_requested = raw.flags & SPA_VIDEO_FLAG_MODIFIER;
		const bool modifier_required = info->pix.modifier() != 0;
		if (modifier_requested != modifier_required ||
			(modifier_requested && raw.modifier != info->pix.modifier()))
			return -EINVAL;
		const int color_res = colorimetry_to_color_space(raw, &requested_color_space);
		if (color_res < 0)
			return color_res;
	}
	if (!framerate_request_valid(framerate))
		return -EINVAL;
	const struct spa_fraction selected_framerate = normalized_framerate(framerate);
	if (size->width == 0 || size->height == 0)
		return -EINVAL;
	if (!impl->camera)
		return -EIO;

	/* Validate a detached candidate first.  TEST_ONLY therefore cannot
	 * mutate the live configuration, rate or allocator state. */
	auto candidate = impl->camera->generateConfiguration({ StreamRole::VideoRecording });
	if (!candidate || candidate->empty())
		return -EIO;
	StreamConfiguration& streamConfig = candidate->at(0);
	streamConfig.pixelFormat = info->pix;
	streamConfig.size.width = size->width;
	streamConfig.size.height = size->height;
	streamConfig.bufferCount = 8;
	if (requested_color_space)
		streamConfig.colorSpace = requested_color_space;

	validation = candidate->validate();
	if (validation == CameraConfiguration::Invalid)
		return -EINVAL;
	const int candidate_res = validate_stream_configuration(candidate.get(),
		*info, *size, requested_color_space, false);
	if (candidate_res < 0)
		return candidate_res;

	if (try_only)
		return 0;

	/* Keep the previous object and caller-owned buffer graph intact until the
	 * replacement has been configured and allocated.  If any step fails, the
	 * old camera and SPA buffers are reconstructed before returning the original
	 * error. */
	const auto old_format = port->current_format;
	const StreamConfiguration old_stream = port->streamConfig;
	const struct spa_fraction old_rate = port->rate;
	const bool was_acquired = impl->acquired;
	const bool was_active = impl->active.load(std::memory_order_acquire);
	const bool had_allocator = impl->allocator.allocated();
	const std::size_t old_request_count = impl->requestPool.size();
	uint32_t old_n_buffers = 0;
	std::array<struct spa_buffer *, MAX_BUFFERS> old_buffers{};
	{
		std::lock_guard<std::mutex> buffer_guard(impl->buffer_mutex);
		if (port->n_buffers > MAX_BUFFERS)
			return -EIO;
		old_n_buffers = port->n_buffers;
		if (old_n_buffers > 0 && !bound_spa_buffer_graph_matches_locked(port))
			return -EPROTO;
		for (uint32_t i = 0; i < old_n_buffers; ++i)
			old_buffers[i] = port->buffers[i].outbuf;
	}
	if ((old_format && (!had_allocator || old_request_count == 0)) ||
		(old_n_buffers > 0 && (!old_format || !had_allocator ||
			old_request_count != old_n_buffers)))
		return -EIO;
	for (uint32_t i = 0; i < old_n_buffers; ++i) {
		if (old_buffers[i] == nullptr)
			return -EIO;
	}

	/* A terminal stream may have active=false while still owning a started
	 * camera, completion signal, data-loop source and eventfd.  Every real
	 * replacement must complete the idempotent stop transition before allocator
	 * ownership changes; was_active controls rollback restart only. */
	const int stop_res = impl->stop(true);
	if (stop_res < 0)
		return stop_res;
	stopping_transaction_guard stopping_guard(impl);

	std::unique_ptr<CameraConfiguration> old_config = std::move(impl->config);
	const unsigned int old_buffer_count = old_request_count > 0
		? static_cast<unsigned int>(old_request_count)
		: (old_config && !old_config->empty() ? old_config->at(0).bufferCount : 0);

	auto quarantine = [&](int error) {
		if (old_config) {
			if (!impl->config)
				impl->config = std::move(old_config);
			else if (!impl->rollback_config)
				impl->rollback_config = std::move(old_config);
		}
		impl->format_transaction_failed = true;
		{
			std::lock_guard<std::mutex> completion_guard(impl->completion_mutex);
			impl->stopping = true;
			impl->active.store(false, std::memory_order_release);
		}
		stopping_guard.abandon();
		mark_completion_failure(impl, error);
		return error;
	};

	auto restore = [&](int original) {
		int restore_res = 0;
		/* First retire any candidate-side ownership.  The old SPA graph is still
		 * untouched at every failure point before the successful commit below;
		 * clearing it here would make rollback silently lose caller metadata. */
		if (!impl->requestPool.empty() || impl->allocator.allocated())
			restore_res = freeBuffers(impl, port);
		if (restore_res == 0 && (!impl->requestPool.empty() || impl->allocator.allocated()))
			restore_res = -EBUSY;
		if (restore_res < 0) {
			/* Keep both configuration owners alive when candidate allocator
			 * retirement fails.  The transaction remains stopped and terminal;
			 * destroying a local old_config here would leave a live allocator
			 * paired with an unrelated or dangling stream configuration. */
			return quarantine(restore_res);
		}

		impl->config = std::move(old_config);
		port->streamConfig = old_stream;
		port->rate = old_rate;
		if (restore_res == 0 && impl->config && old_format && !impl->config->empty()) {
			if (!impl->acquired && was_acquired)
				restore_res = spa_libcamera_open(impl);
			if (restore_res == 0)
				restore_res = impl->camera->configure(impl->config.get());
			if (restore_res == 0)
				port->streamConfig = impl->config->at(0);
			if (restore_res == 0 && had_allocator && old_buffer_count > 0)
				restore_res = allocBuffers(impl, port, old_buffer_count);
			if (restore_res == 0 && old_n_buffers > 0)
				restore_res = spa_libcamera_rebind_buffers(impl, port,
					old_buffers.data(), old_n_buffers);
		}
		if (restore_res == 0 && was_active) {
			/* The old stream was active when negotiation began.  Restart it only
			 * after the old allocator and graph are fully restored. */
			stopping_guard.finish();
			restore_res = spa_libcamera_stream_on(impl);
		}
		if (!was_acquired && impl->acquired && !restore_res) {
			const int close_res = spa_libcamera_close(impl);
			if (close_res < 0)
				restore_res = close_res;
		}
		if (restore_res < 0)
			spa_log_error(impl->log, "failed to restore previous camera format: %s",
					spa_strerror(restore_res));
		if (restore_res < 0) {
			return quarantine(restore_res);
		}
		return original;
	};

	if (!impl->requestPool.empty() || impl->allocator.allocated()) {
		const int free_res = freeBuffers(impl, port);
		if (free_res < 0)
			return restore(free_res);
	}

	int res = spa_libcamera_open(impl);
	if (res < 0)
		return restore(res);
	res = impl->camera->configure(candidate.get());
	if (res != 0)
		return restore(res);
	res = validate_stream_configuration(candidate.get(), *info, *size,
		requested_color_space, true);
	if (res < 0)
		return restore(res);

	impl->config = std::move(candidate);
	port->streamConfig = impl->config->at(0);
	res = allocBuffers(impl, port, port->streamConfig.bufferCount);
	if (res < 0)
		return restore(res);
	if (old_n_buffers > 0) {
		int clear_res;
		{
			std::lock_guard<std::mutex> buffer_guard(impl->buffer_mutex);
			clear_res = clear_buffers_locked(port);
		}
		if (clear_res < 0)
			return restore(clear_res);
	}

	/* Publish the normalized rate only after the candidate is fully configured
	 * and the old caller-owned graph has been detached. */
	*framerate = selected_framerate;
	if (format->media_subtype == SPA_MEDIA_SUBTYPE_raw) {
		auto &raw = format->info.raw;
		if (port->streamConfig.pixelFormat.modifier() != 0) {
			raw.flags |= SPA_VIDEO_FLAG_MODIFIER;
			raw.modifier = port->streamConfig.pixelFormat.modifier();
		} else {
			raw.flags &= ~SPA_VIDEO_FLAG_MODIFIER;
			raw.modifier = 0;
		}
		publish_color_space(port->streamConfig.colorSpace, &raw);
	}
	port->rate = framerate_to_clock_rate(selected_framerate);

	port->info.change_mask |= SPA_PORT_CHANGE_MASK_FLAGS | SPA_PORT_CHANGE_MASK_RATE;
	port->info.flags = SPA_PORT_FLAG_CAN_ALLOC_BUFFERS |
		SPA_PORT_FLAG_LIVE |
		SPA_PORT_FLAG_PHYSICAL |
		SPA_PORT_FLAG_TERMINAL;
	port->info.rate = SPA_FRACTION(port->rate.num, port->rate.denom);
	impl->format_transaction_failed = false;
	impl->rollback_config.reset();
	impl->completion_error.store(0, std::memory_order_release);

	return 0;
}

const struct {
	uint32_t id;
	uint32_t spa_id;
} control_map[] = {
	{ libcamera::controls::BRIGHTNESS, SPA_PROP_brightness },
	{ libcamera::controls::CONTRAST, SPA_PROP_contrast },
	{ libcamera::controls::SATURATION, SPA_PROP_saturation },
	{ libcamera::controls::EXPOSURE_TIME, SPA_PROP_exposure },
	{ libcamera::controls::ANALOGUE_GAIN, SPA_PROP_gain },
	{ libcamera::controls::SHARPNESS, SPA_PROP_sharpness },
};

uint32_t control_to_prop_id(uint32_t control_id)
{
	for (const auto& c : control_map) {
		if (c.id == control_id)
			return c.spa_id;
	}

	return SPA_PROP_START_CUSTOM + control_id;
}

uint32_t prop_id_to_control(uint32_t prop_id)
{
	if (prop_id >= SPA_PROP_START_CUSTOM)
		return prop_id - SPA_PROP_START_CUSTOM;

	for (const auto& c : control_map) {
		if (c.spa_id == prop_id)
			return c.id;
	}

	return SPA_ID_INVALID;
}

[[nodiscard]]
ControlValue control_value_from_pod(const libcamera::ControlId& cid, const spa_pod *value)
{
	if (cid.isArray())
		return {};

	switch (cid.type()) {
	case libcamera::ControlTypeBool: {
		bool v;
		if (spa_pod_get_bool(value, &v) < 0)
			return {};

		return v;
	}
	case libcamera::ControlTypeInteger32: {
		int32_t v;
		if (spa_pod_get_int(value, &v) < 0)
			return {};

		return v;
	}
	case libcamera::ControlTypeFloat: {
		float v;
		if (spa_pod_get_float(value, &v) < 0)
			return {};

		return v;
	}
	default:
		return {};
	}

	return {};
}

[[nodiscard]]
static bool control_value_is_valid(const libcamera::ControlInfo &info,
		const libcamera::ControlValue &value)
{
	if (value.isNone() || value.isArray())
		return false;

	/* A NaN cannot be a useful camera control even when a malformed
	 * enumeration happens to contain one. */
	if (value.type() == libcamera::ControlTypeFloat &&
		!std::isfinite(value.get<float>()))
		return false;

	if (!info.values().empty())
		return std::any_of(info.values().begin(), info.values().end(),
			[&value](const libcamera::ControlValue &allowed) {
				return allowed == value;
			});

	if (info.min().type() != value.type() || info.max().type() != value.type())
		return false;

	switch (value.type()) {
	case libcamera::ControlTypeBool: {
		const bool min = info.min().get<bool>();
		const bool max = info.max().get<bool>();
		return min <= max && value.get<bool>() >= min && value.get<bool>() <= max;
	}
	case libcamera::ControlTypeInteger32: {
		const int32_t min = info.min().get<int32_t>();
		const int32_t max = info.max().get<int32_t>();
		return min <= max && value.get<int32_t>() >= min && value.get<int32_t>() <= max;
	}
	case libcamera::ControlTypeFloat: {
		const float min = info.min().get<float>();
		const float max = info.max().get<float>();
		return std::isfinite(min) && std::isfinite(max) && min <= max &&
			value.get<float>() >= min && value.get<float>() <= max;
	}
	default:
		return false;
	}
}

int control_list_update_from_prop(libcamera::ControlList& list, const spa_pod_prop *prop)
{
	auto id = prop_id_to_control(prop->key);
	if (id == SPA_ID_INVALID)
		return -ENOENT;

	auto it = list.idMap()->find(id);
	if (it == list.idMap()->end())
		return -ENOENT;

	if (!list.infoMap()->count(it->second))
		return -ENOENT;

	auto val = control_value_from_pod(*it->second, &prop->value);
	if (val.isNone())
		return -EINVAL;
	if (!control_value_is_valid(list.infoMap()->at(it->second), val))
		return -ERANGE;

	list.set(id, std::move(val));

	return 0;
}

static bool checked_pod_advance(uint64_t unpadded_size, uint64_t remaining,
		uint64_t *padded_size)
{
	if (padded_size == nullptr ||
		unpadded_size > std::numeric_limits<uint64_t>::max() - 7)
		return false;
	const uint64_t rounded = SPA_ROUND_UP_N(unpadded_size, 8);
	if (rounded < unpadded_size || rounded > remaining)
		return false;
	*padded_size = rounded;
	return true;
}

static int control_list_update_from_props_pod(libcamera::ControlList &list,
		const struct spa_pod *pod, uint64_t available)
{
	static constexpr uint64_t max_props_pod_size = 1024 * 1024;
	if (pod == nullptr || available < sizeof(struct spa_pod) ||
		!naturally_aligned<struct spa_pod>(pod))
		return -EINVAL;

	const uint64_t pod_size = sizeof(struct spa_pod) +
		static_cast<uint64_t>(pod->size);
	if (pod_size > available || pod_size > max_props_pod_size ||
		!spa_pod_is_object(pod) ||
		pod->size < sizeof(struct spa_pod_object_body))
		return -EINVAL;

	const auto *obj = reinterpret_cast<const struct spa_pod_object *>(pod);
	if (SPA_POD_OBJECT_TYPE(obj) != SPA_TYPE_OBJECT_Props)
		return -EINVAL;
	/* Decode into a private copy so a later malformed or out-of-range
	 * property cannot leave a partially applied request behind. */
	libcamera::ControlList candidate = list;

	const uint64_t properties_size =
		static_cast<uint64_t>(pod->size) - sizeof(obj->body);
	const auto object_address = reinterpret_cast<std::uintptr_t>(obj);
	if (object_address > std::numeric_limits<std::uintptr_t>::max() - sizeof(*obj))
		return -EINVAL;
	const auto properties_address = object_address + sizeof(*obj);
	if (properties_address > std::numeric_limits<std::uintptr_t>::max() -
		properties_size)
		return -EINVAL;

	uint64_t cursor = 0;
	while (cursor < properties_size) {
		const uint64_t remaining = properties_size - cursor;
		if (remaining < sizeof(struct spa_pod_prop))
			return -EINVAL;

		const auto prop_address = properties_address + cursor;
		if (prop_address % alignof(struct spa_pod_prop) != 0)
			return -EINVAL;
		const auto *prop = reinterpret_cast<const struct spa_pod_prop *>(
			prop_address);
		const uint64_t prop_size = sizeof(*prop) +
			static_cast<uint64_t>(prop->value.size);
		uint64_t padded_prop_size;
		if (!checked_pod_advance(prop_size, remaining, &padded_prop_size))
			return -EINVAL;

		const int res = control_list_update_from_prop(candidate, prop);
		if (res < 0)
			return res;
		cursor += padded_prop_size;
	}

	if (cursor != properties_size)
		return -EINVAL;
	list = std::move(candidate);
	return 0;
}

[[nodiscard]]
bool control_value_to_pod(spa_pod_builder& b, const libcamera::ControlValue& cv)
{
	if (cv.isArray())
		return false;

	switch (cv.type()) {
	case libcamera::ControlTypeBool: {
		spa_pod_builder_bool(&b, cv.get<bool>());
		break;
	}
	case libcamera::ControlTypeInteger32: {
		spa_pod_builder_int(&b, cv.get<int32_t>());
		break;
	}
	case libcamera::ControlTypeFloat: {
		spa_pod_builder_float(&b, cv.get<float>());
		break;
	}
	default:
		return false;
	}

	return true;
}

template<typename T>
[[nodiscard]]
std::array<T, 3> control_info_to_range(const libcamera::ControlInfo& cinfo)
{
	static_assert(std::is_arithmetic_v<T>);

	auto min = cinfo.min().get<T>();
	auto max = cinfo.max().get<T>();
	spa_assert(min <= max);

	T def;
	if (!cinfo.def().isNone()) {
		def = cinfo.def().get<T>();
	} else {
		/* Do the midpoint in a wider domain.  The previous int32_t
		 * subtraction overflowed for a legal full-range control and could
		 * advertise a value outside the camera's range. */
		const long double midpoint = static_cast<long double>(min) +
			(static_cast<long double>(max) - static_cast<long double>(min)) / 2.0L;
		const long double lower = static_cast<long double>(std::numeric_limits<T>::lowest());
		const long double upper = static_cast<long double>(std::numeric_limits<T>::max());
		def = static_cast<T>(std::clamp(midpoint, lower, upper));
	}
	def = std::clamp(def, min, max);

	return {{ min, max, def }};
}

[[nodiscard]]
spa_pod *control_details_to_pod(spa_pod_builder& b,
				const libcamera::ControlId& cid, const libcamera::ControlInfo& cinfo)
{
	if (cid.isArray())
		return nullptr;

	auto id = control_to_prop_id(cid.id());
	spa_pod_frame f;

	spa_pod_builder_push_object(&b, &f, SPA_TYPE_OBJECT_PropInfo, SPA_PARAM_PropInfo);
	spa_pod_builder_add(&b,
			SPA_PROP_INFO_id,   SPA_POD_Id(id),
			SPA_PROP_INFO_description, SPA_POD_String(cid.name().c_str()),
			0);

	if (cinfo.values().empty()) {
		switch (cid.type()) {
		case ControlTypeBool: {
			auto min = cinfo.min().get<bool>();
			auto max = cinfo.max().get<bool>();
			auto def = !cinfo.def().isNone()
				? cinfo.def().get<bool>()
				: min;
			spa_pod_frame f;

			spa_pod_builder_prop(&b, SPA_PROP_INFO_type, 0);
			spa_pod_builder_push_choice(&b, &f, SPA_CHOICE_Enum, 0);
			spa_pod_builder_bool(&b, def);
			spa_pod_builder_bool(&b, min);
			if (max != min)
				spa_pod_builder_bool(&b, max);
			spa_pod_builder_pop(&b, &f);
			break;
		}
		case ControlTypeFloat: {
			auto [ min, max, def ] = control_info_to_range<float>(cinfo);

			spa_pod_builder_add(&b,
					SPA_PROP_INFO_type, SPA_POD_CHOICE_RANGE_Float(
							def, min, max),
					0);
			break;
		}
		case ControlTypeInteger32: {
			auto [ min, max, def ] = control_info_to_range<int32_t>(cinfo);

			spa_pod_builder_add(&b,
					SPA_PROP_INFO_type, SPA_POD_CHOICE_RANGE_Int(
							def, min, max),
					0);
			break;
		}
		default:
			return nullptr;
		}
	}
	else {
		spa_pod_frame f;

		spa_pod_builder_prop(&b, SPA_PROP_INFO_type, 0);
		spa_pod_builder_push_choice(&b, &f, SPA_CHOICE_Enum, 0);

		if (!control_value_to_pod(b, cinfo.def()))
			return nullptr;

		for (const auto& cv : cinfo.values()) {
			if (!control_value_to_pod(b, cv))
				return nullptr;
		}

		spa_pod_builder_pop(&b, &f);

		if (cid.type() == libcamera::ControlTypeInteger32) {
			spa_pod_builder_prop(&b, SPA_PROP_INFO_labels, 0);

			spa_pod_builder_push_struct(&b, &f);
			for (const auto& cv : cinfo.values()) {
				auto it = cid.enumerators().find(cv.get<int32_t>());
				if (it == cid.enumerators().end())
					continue;

				spa_pod_builder_int(&b, it->first);
				spa_pod_builder_string_len(&b, it->second.data(), it->second.size());
			}
			spa_pod_builder_pop(&b, &f);
		}
	}

	return reinterpret_cast<spa_pod *>(spa_pod_builder_pop(&b, &f));
}

int
spa_libcamera_enum_controls(struct impl *impl, struct port *port, int seq,
		       uint32_t start, uint32_t offset, uint32_t num,
		       const struct spa_pod *filter)
{
	const ControlInfoMap &info = impl->camera->controls();
	spa_auto(spa_pod_dynamic_builder) b = {};
	spa_pod_builder_state state;
	uint8_t buffer[4096];
	spa_result_node_params result = {
		.id = SPA_PARAM_PropInfo,
	};

	auto it = info.begin();
	for (auto skip = start - offset; skip && it != info.end(); skip--)
		it++;

	spa_pod_dynamic_builder_init(&b, buffer, sizeof(buffer), 4096);
	spa_pod_builder_get_state(&b.b, &state);

	for (result.index = start; num > 0 && it != info.end(); ++it, result.index++) {
		spa_log_debug(impl->log, "%p: controls[%" PRIu32 "]: %s::%s",
				impl, result.index, it->first->vendor().c_str(),
				it->first->name().c_str());

		spa_pod_builder_reset(&b.b, &state);

		const auto *ctrl = control_details_to_pod(b.b, *it->first, it->second);
		if (!ctrl)
			continue;

		if (spa_pod_filter(&b.b, &result.param, ctrl, filter) < 0)
			continue;

		result.next = result.index + 1;

		spa_node_emit_result(&impl->hooks, seq, 0, SPA_RESULT_TYPE_NODE_PARAMS, &result);
		num -= 1;
	}

	return 0;
}

int spa_libcamera_apply_controls(struct impl *impl, libcamera::ControlList&& controls)
{
	if (impl == nullptr || impl->data_loop == nullptr)
		return -EINVAL;
	if (controls.empty())
		return 0;

	struct invoke_data {
		ControlList *controls;
	} d = {
		.controls = &controls,
	};

	return spa_loop_invoke(
		impl->data_loop,
		[](spa_loop *, bool, uint32_t, const void *data, size_t, void *user_data)
		{
			const auto *d = static_cast<const invoke_data *>(data);
			auto *impl = static_cast<struct impl *>(user_data);

			std::lock_guard<std::mutex> controls_guard(impl->controls_mutex);
			impl->ctrls.merge(std::move(*d->controls),
					  libcamera::ControlList::MergePolicy::OverwriteExisting);

			return 0;
		},
		0, &d, sizeof(d), true, impl
	);
}


