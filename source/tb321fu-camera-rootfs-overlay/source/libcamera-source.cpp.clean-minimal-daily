void setup_initial_controls(const ControlInfoMap& ctrl_infos, ControlList& ctrls)
{
	/* Libcamera recommends cameras default to manual focus mode, but we don't
	 * expose any focus controls.  So, specifically enable autofocus on
	 * cameras which support it. */
	auto af_it = ctrl_infos.find(libcamera::controls::AF_MODE);
	if (af_it != ctrl_infos.end()) {
		const ControlInfo &ctrl_info = af_it->second;
		auto is_af_continuous = [](const ControlValue &value) {
			return value.get<int32_t>() == libcamera::controls::AfModeContinuous;
		};
		if (std::any_of(ctrl_info.values().begin(),
		    ctrl_info.values().end(), is_af_continuous)) {
			ctrls.set(libcamera::controls::AF_MODE,
					libcamera::controls::AfModeContinuous);
		}
	}

	auto ae_it = ctrl_infos.find(libcamera::controls::AE_ENABLE);
	if (ae_it != ctrl_infos.end()) {
		ctrls.set(libcamera::controls::AE_ENABLE, true);
	}
}

int spa_libcamera_open(struct impl *impl)
{
	if (impl == nullptr || !impl->camera)
		return -EIO;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	if (impl->acquired)
		return 0;

	spa_log_info(impl->log, "open camera %s", impl->camera->id().c_str());

	if (int res = impl->camera->acquire(); res < 0)
		return res;

	spa_assert(!impl->allocator.allocated());

	const ControlInfoMap &controls = impl->camera->controls();
	setup_initial_controls(controls, impl->initial_controls);

	impl->acquired = true;
	return 0;
}

int spa_libcamera_close(struct impl *impl)
{
	if (impl == nullptr)
		return -EINVAL;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	struct port *port = &impl->out_ports[0];
	if (!impl->acquired)
		return 0;
	if (impl->active.load(std::memory_order_acquire) || port->current_format)
		return 0;

	spa_log_info(impl->log, "close camera %s", impl->camera->id().c_str());

	if (impl->allocator.allocated() || !impl->requestPool.empty())
		return -EBUSY;

	if (!impl->camera)
		return -EIO;
	impl->camera->release();

	impl->acquired = false;
	return 0;
}

static int recycle_buffer_locked(struct impl *impl, struct port *port,
		uint32_t buffer_id)
{
	if (impl == nullptr || port == nullptr)
		return -EINVAL;
	if (buffer_id >= MAX_BUFFERS || buffer_id >= port->n_buffers ||
		buffer_id >= impl->requestPool.size()) {
		if (impl->log)
			spa_log_warn(impl->log, "invalid buffer_id %u", buffer_id);
		return -EINVAL;
	}
	struct buffer *b = &port->buffers[buffer_id];
	int res;

	if (!SPA_FLAG_IS_SET(b->flags, BUFFER_FLAG_OUTSTANDING))
		return 0;

	Request *request = impl->requestPool[buffer_id].get();
	if (request == nullptr || impl->camera == nullptr)
		return -EIO;
	if (request->cookie() != buffer_id) {
		mark_completion_failure(impl, -EPROTO);
		return -EPROTO;
	}
	SPA_FLAG_CLEAR(b->flags, BUFFER_FLAG_OUTSTANDING);

	/* queueRequest() and camera->stop() must not cross.  stop() publishes its
	 * latch before waiting for camera_io_mutex, so the second state check below
	 * deterministically chooses either queue-before-stop or no queue. */
	std::lock_guard<std::mutex> camera_guard(impl->camera_io_mutex);
	bool should_queue;
	{
		std::lock_guard<std::mutex> lock(impl->completion_mutex);
		should_queue = impl->active.load(std::memory_order_acquire) &&
			!impl->stopping;
	}
	if (should_queue) {
		std::lock_guard<std::mutex> controls_guard(impl->controls_mutex);
		request->controls().merge(impl->ctrls);
		if ((res = impl->camera->queueRequest(request)) < 0) {
			SPA_FLAG_SET(b->flags, BUFFER_FLAG_OUTSTANDING);
			spa_log_warn(impl->log, "can't queue buffer %u: %s",
				buffer_id, spa_strerror(res));
			mark_completion_failure(impl, res == -EACCES ? -EBUSY : res);
			return res == -EACCES ? -EBUSY : res;
		}
		/* Consume pending controls only after queueRequest accepts the request. */
		impl->ctrls.clear();
	}
	return 0;
}

int freeBuffers(struct impl *impl, struct port *port)
{
	if (impl == nullptr || port == nullptr)
		return -EINVAL;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	int result = 0;
	if (impl->allocator.allocated()) {
		if (Stream *stream = port->streamConfig.stream()) {
			const int res = impl->allocator.free(stream);
			if (res < 0)
				result = res;
			else if (impl->allocator.allocated())
				result = -EIO;
		} else {
			result = -EIO;
		}
	}
	/* Request objects contain non-owning FrameBuffer references.  Retain them
	 * until allocator::free() has succeeded so a failed teardown can be
	 * retried without losing ownership/accounting. */
		if (result == 0) {
			impl->requestPool.clear();
			port->buffers_blocks = 1;
		}
	if (result < 0 && impl->log)
		spa_log_error(impl->log, "failed to free camera buffers: %s",
				spa_strerror(result));
	return result;
}

struct plane_group_binding {
	int fd = -1;
	uint32_t offset = 0;
	uint32_t size = 0;
	uint32_t first_plane = 0;
	uint32_t plane_count = 0;
};

static int build_plane_groups(
		libcamera::Span<const libcamera::FrameBuffer::Plane> planes,
		std::array<plane_group_binding, MAX_BUFFERS> *groups,
		std::size_t *group_count)
{
	if (groups == nullptr || group_count == nullptr || planes.empty() ||
		planes.size() > MAX_BUFFERS)
		return -EINVAL;
	groups->fill({});
	*group_count = 0;
	for (std::size_t plane_index = 0; plane_index < planes.size(); ++plane_index) {
		const auto &plane = planes[plane_index];
		const int fd = plane.fd.get();
		if (fd < 0 || plane.length == 0 ||
			plane.length > std::numeric_limits<uint32_t>::max() ||
			plane.offset > std::numeric_limits<uint32_t>::max() - plane.length)
			return -EOVERFLOW;
		const uint32_t offset = static_cast<uint32_t>(plane.offset);
		const uint32_t end = offset + static_cast<uint32_t>(plane.length);

		if (*group_count == 0 || (*groups)[*group_count - 1].fd != fd) {
			if (*group_count >= groups->size())
				return -EOVERFLOW;
			auto &group = (*groups)[(*group_count)++];
			group.fd = fd;
			group.offset = offset;
			group.size = static_cast<uint32_t>(plane.length);
			group.first_plane = static_cast<uint32_t>(plane_index);
			group.plane_count = 1;
			continue;
		}

		auto &group = (*groups)[*group_count - 1];
		const uint32_t group_end = group.offset + group.size;
		const uint32_t merged_start = std::min(group.offset, offset);
		const uint32_t merged_end = std::max(group_end, end);
		group.offset = merged_start;
		group.size = merged_end - merged_start;
		++group.plane_count;
	}
	return 0;
}

int allocBuffers(struct impl *impl, struct port *port, unsigned int count)
{
	if (impl == nullptr || port == nullptr || impl->camera == nullptr ||
		!impl->config || impl->config->empty() || count == 0 || count > MAX_BUFFERS)
		return -EINVAL;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	libcamera::Stream *stream = port->streamConfig.stream();
	if (stream == nullptr)
		return -EIO;
	int res;
	std::size_t expected_group_count = 0;

	if (!impl->requestPool.empty())
		return -EBUSY;
	if (impl->allocator.allocated())
		return -EBUSY;

	if ((res = impl->allocator.allocate(stream)) < 0)
		return res;

	const auto& bufs = impl->allocator.buffers(stream);
	if (bufs.empty() || bufs.size() != count) {
		res = -ENOBUFS;
		goto err;
	}

	for (std::size_t i = 0; i < bufs.size(); i++) {
		if (!bufs[i]) {
			res = -ENOBUFS;
			goto err;
		}
		const auto &planes = bufs[i]->planes();
		if (planes.empty()) {
			res = -ENOBUFS;
			goto err;
		}
		std::array<plane_group_binding, MAX_BUFFERS> groups{};
		std::size_t group_count = 0;
		res = build_plane_groups(planes, &groups, &group_count);
		if (res < 0)
			goto err;
		if (i == 0)
			expected_group_count = group_count;
		else if (group_count != expected_group_count) {
			res = -EINVAL;
			goto err;
		}
		std::unique_ptr<Request> request = impl->camera->createRequest(i);
		if (!request) {
			res = -ENOMEM;
			goto err;
		}
		if (request->cookie() != i) {
			res = -EINVAL;
			goto err;
		}

		res = request->addBuffer(stream, bufs[i].get());
		if (res < 0)
			goto err;

		impl->requestPool.push_back(std::move(request));
	}

	/* Some devices require data for each output video frame to be
	 * placed in discontiguous memory buffers. In such cases, one
	 * video frame has to be addressed using more than one memory.
	 * address. Therefore, need calculate the number of discontiguous
	 * memory and allocate the specified amount of memory */
	port->buffers_blocks = static_cast<uint32_t>(expected_group_count);
	if (port->buffers_blocks == 0) {
		res = -ENOBUFS;
		goto err;
	}

	return 0;

err:
	const int cleanup_res = freeBuffers(impl, port);
	if (cleanup_res < 0 && impl->log)
		spa_log_error(impl->log, "camera buffer cleanup failed: %s",
				spa_strerror(cleanup_res));

	return cleanup_res < 0 ? cleanup_res : res;
}

static bool bound_spa_buffer_matches_locked(const struct buffer &bound)
{
	const struct spa_buffer *sb = bound.outbuf;
	if (sb == nullptr || sb->metas != bound.validated_metas ||
		sb->n_metas != bound.validated_n_metas ||
		sb->datas != bound.validated_datas || bound.validated_datas == nullptr ||
		sb->n_datas != bound.validated_n_datas ||
		bound.validated_n_datas == 0 || bound.validated_n_datas > MAX_BUFFERS)
		return false;
	if (spa_buffer_find_meta_data(sb, SPA_META_Header, sizeof(*bound.h)) != bound.h ||
		spa_buffer_find_meta_data(sb, SPA_META_VideoTransform,
			sizeof(*bound.videotransform)) != bound.videotransform)
		return false;
	for (uint32_t i = 0; i < bound.validated_n_datas; ++i) {
		const struct spa_data &data = bound.validated_datas[i];
		if (data.chunk == nullptr || data.chunk != bound.validated_chunks[i] ||
				data.type != bound.validated_types[i] ||
				data.flags != bound.validated_flags[i] ||
				data.fd != bound.validated_fds[i] ||
				data.mapoffset != bound.validated_mapoffsets[i] ||
				data.maxsize != bound.validated_maxsizes[i] ||
				data.chunk->stride != bound.validated_strides[i] ||
				data.chunk->offset > data.maxsize ||
				data.chunk->size > data.maxsize - data.chunk->offset)
			return false;
	}
	return true;
}

static bool bound_spa_buffer_graph_matches_locked(const struct port *port)
{
	if (port == nullptr || port->n_buffers > MAX_BUFFERS)
		return false;
	for (uint32_t i = 0; i < port->n_buffers; ++i) {
		if (!bound_spa_buffer_matches_locked(port->buffers[i]))
			return false;
	}
	return true;
}

static int clear_buffers_locked(struct port *port)
{
	if (port == nullptr || !bound_spa_buffer_graph_matches_locked(port))
		return -EPROTO;
	const uint32_t count = port->n_buffers;
	for (uint32_t i = 0; i < count; i++) {
		buffer *b = &port->buffers[i];

		if (b->queued) {
			spa_list_remove(&b->link);
			b->queued = false;
			spa_list_init(&b->link);
		}

		for (uint32_t j = 0; j < b->validated_n_datas; j++) {
			auto *data = &b->validated_datas[j];

			data->type = SPA_ID_INVALID;
			data->data = nullptr;
			data->fd = -1;
		}

		*b = buffer{};
		spa_list_init(&b->link);
	}

	spa_list_init(&port->queue);
	if (port->io && port->io->buffer_id < count) {
		port->io->buffer_id = SPA_ID_INVALID;
		if (port->io->status == SPA_STATUS_HAVE_DATA)
			port->io->status = SPA_STATUS_OK;
	}
	port->n_buffers = 0;

	return 0;
}

