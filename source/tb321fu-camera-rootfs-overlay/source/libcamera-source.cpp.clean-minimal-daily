struct impl {
	struct spa_node node = {};

	struct spa_log *log;
	struct spa_loop *data_loop;
	struct spa_system *system;

	static constexpr uint64_t info_all =
		SPA_NODE_CHANGE_MASK_FLAGS |
		SPA_NODE_CHANGE_MASK_PROPS |
		SPA_NODE_CHANGE_MASK_PARAMS;
	struct spa_node_info info = SPA_NODE_INFO_INIT();
#define NODE_PropInfo	0
#define NODE_Props	1
#define NODE_EnumFormat	2
#define NODE_Format	3
#define N_NODE_PARAMS	4
	struct spa_param_info params[N_NODE_PARAMS];

	struct spa_hook_list hooks;
	struct spa_callbacks callbacks = {};

	std::array<port, 1> out_ports;

	struct spa_io_position *position = nullptr;
	std::size_t position_size = 0;
	struct spa_io_clock *clock = nullptr;
	std::size_t clock_size = 0;

	struct spa_latency_info latency[2];

	std::shared_ptr<CameraManager> manager;
	std::shared_ptr<Camera> camera;
	/* The configuration object is replaced only after a candidate has been
	 * validated and configured successfully.  Keeping ownership mutable lets
	 * format renegotiation retain the old object for rollback. */
	std::unique_ptr<CameraConfiguration> config;
	/* A failed format transaction may leave the candidate allocator alive while
	 * the previous configuration is retained for diagnostics/terminal cleanup.
	 * Keep that second owner explicit instead of letting a local rollback object
	 * dangle when allocator retirement fails. */
	std::unique_ptr<CameraConfiguration> rollback_config;
	bool format_transaction_failed = false;

	FrameBufferAllocator allocator;
	std::vector<std::unique_ptr<libcamera::Request>> requestPool;
	spa_ringbuffer completed_requests_rb = SPA_RINGBUFFER_INIT();
	std::array<libcamera::Request *, COMPLETION_RING_SIZE> completed_requests{};
	/* The libcamera signal may run concurrently with the PipeWire data loop.
	 * This lock protects ring slots and the eventfd lifetime. */
	std::mutex completion_mutex;
	std::condition_variable completion_cv;
	unsigned int callbacks_inflight = 0;
	unsigned int processes_inflight = 0;
	bool stopping = false;
	std::atomic<int> completion_error{0};
	/* Provider ownership is observed by lifecycle and data-loop threads.  Keep
	 * the spa_source fields for PipeWire, but mirror their state atomically so
	 * terminal-clear checks never infer ownership from an unlocked field. */
	std::atomic<bool> signal_connected{false};
	std::atomic<bool> source_registered{false};
	std::atomic<int> source_fd{-1};
	/* Buffer metadata is touched by both the PipeWire data loop and libcamera
	 * completion delivery.  It cannot use lifecycle_mutex because stop() waits
	 * for those callbacks while holding the lifecycle transaction. */
	std::mutex buffer_mutex;
	std::mutex controls_mutex;
	std::recursive_mutex callbacks_mutex;
	/* Serialize queueRequest() against camera start/stop without making a
	 * completion callback wait for lifecycle_mutex. */
	std::mutex camera_io_mutex;
	/* All synchronous node/lifecycle entry points serialize against one
	 * another.  Completion callbacks use completion_mutex and never wait for
	 * this lock, so a stop issued from a foreign thread cannot deadlock the
	 * data-loop callback. */
	std::recursive_mutex lifecycle_mutex;
	/* Display rotation is session-local state.  Keep it per node so multiple
	 * camera instances cannot share a stale inotify descriptor or cache. */
	std::mutex rotation_mutex;
	int display_rotation_cached = 1;
	bool display_rotation_initialized = false;
	bool display_rotation_refresh_pending = true;
	std::chrono::steady_clock::time_point display_rotation_retry_after{};
	int display_rotation_inotify_fd = -1;
	int display_rotation_inotify_wd = -1;
	std::string display_rotation_config_dir;
	pid_t display_rotation_child_pid = -1;

	void requestComplete(libcamera::Request *request);

	struct spa_source source = {};

	ControlList ctrls;
	ControlList initial_controls;
	std::atomic<bool> active{false};
	bool acquired = false;
	std::atomic<bool> camera_started{false};

	impl(spa_log *log, spa_loop *data_loop, spa_system *system,
	     std::shared_ptr<CameraManager> manager, std::shared_ptr<Camera> camera,
	     std::unique_ptr<CameraConfiguration> config);

	struct spa_dll dll;

	int stop(bool keep_stopping = false)
	{
		std::lock_guard<std::recursive_mutex> lifecycle_guard(lifecycle_mutex);
		int first_error = 0;
		{
			std::lock_guard<std::mutex> guard(completion_mutex);
			/* Reject new producers before disconnecting the signal.  A producer
			 * already inside requestComplete is accounted for below. */
			stopping = true;
			active.store(false, std::memory_order_release);
		}

		/* Source removal must run in the data-loop context.  Do not destroy the
		 * eventfd or request graph until the callback activity guard below has
		 * observed quiescence. */
		int remove_res = 0;
		for (unsigned int attempt = 0;
			source_registered.load(std::memory_order_acquire) && attempt < 3;
			++attempt) {
			if (!data_loop) {
				remove_res = -EINVAL;
				break;
			}
			remove_res = spa_loop_invoke(
				data_loop,
				camera_remove_source_invoke,
				0, nullptr, 0, true, this);
			if (remove_res >= 0 &&
				!source_registered.load(std::memory_order_acquire))
				break;
		}
		if (source_registered.load(std::memory_order_acquire)) {
			if (!first_error)
				first_error = remove_res < 0 ? remove_res : -EBUSY;
			if (log)
				spa_log_warn(log, "failed to remove camera event source: %s",
					spa_strerror(first_error));
			}
			{
				std::unique_lock<std::mutex> lock(completion_mutex);
				/* A data-loop process invocation never takes lifecycle_mutex.  Wait for
				 * every invocation which crossed the stopping latch before changing the
				 * camera or allocator state. */
				if (!completion_cv.wait_for(lock, std::chrono::seconds(5),
					[this] { return processes_inflight == 0; })) {
					if (!first_error)
						first_error = -ETIMEDOUT;
					return first_error;
				}
			}
		if (camera && camera_started.load(std::memory_order_acquire)) {
			std::lock_guard<std::mutex> camera_guard(camera_io_mutex);
			if (int res = camera->stop(); res < 0) {
				if (!first_error)
					first_error = res;
				if (log)
					spa_log_warn(log, "failed to stop camera %s: %s",
							 camera->id().c_str(), spa_strerror(res));
			} else {
				camera_started.store(false, std::memory_order_release);
			}
		}
		/* Camera::stop() completes every pending request synchronously in this
		 * libcamera version.  Keep the signal connected through that boundary so
		 * cancellation callbacks are accounted for, then prevent future emits. */
		if (camera && !camera_started.load(std::memory_order_acquire) &&
			signal_connected.load(std::memory_order_acquire)) {
			camera->requestCompleted.disconnect(this, &impl::requestComplete);
			signal_connected.store(false, std::memory_order_release);
		}
		{
			std::unique_lock<std::mutex> lock(completion_mutex);
			/* A broken callback must never make clear() wait forever.  Keep
			 * ownership of every resource when the bounded quiescence wait fails;
			 * the caller can retry stop() after the provider has settled. */
				if (!completion_cv.wait_for(lock, std::chrono::seconds(5),
					[this] {
						return callbacks_inflight == 0 && processes_inflight == 0;
					})) {
				if (!first_error)
					first_error = -ETIMEDOUT;
				return first_error;
			}

			if (source_registered.load(std::memory_order_acquire) ||
				camera_started.load(std::memory_order_acquire) ||
				signal_connected.load(std::memory_order_acquire)) {
				if (!first_error)
					first_error = -EBUSY;
				return first_error;
			}

			const int fd = source_fd.load(std::memory_order_acquire);
			if (fd >= 0 && system) {
				const int res = spa_system_close(system, fd);
				if (res < 0) {
					if (!first_error)
						first_error = res;
					/* Keep the descriptor and ring intact.  A later retry is the
					 * only safe point at which it may be closed. */
					return first_error;
				}
				source.fd = -1;
				source_fd.store(-1, std::memory_order_release);
			} else {
				source.fd = -1;
				source_fd.store(-1, std::memory_order_release);
			}
			source.func = nullptr;
			source.data = nullptr;
			source.mask = 0;
			source.rmask = 0;

			/* Requests already handed to the completion ring still own their
			 * libcamera buffers. Reuse them before dropping the ring. */
			for (auto *request : completed_requests) {
				if (request)
					request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
			}
			completed_requests.fill(nullptr);
			completed_requests_rb = SPA_RINGBUFFER_INIT();
			/* A failed transition leaves the latch set and therefore prevents a
			 * new request from racing the caller's retry. */
			stopping = keep_stopping || first_error < 0;
		}

		{
			std::lock_guard<std::mutex> buffer_guard(buffer_mutex);
			for (auto& p : out_ports) {
				spa_list_init(&p.queue);
				for (uint32_t i = 0; i < p.n_buffers && i < MAX_BUFFERS; ++i) {
					SPA_FLAG_CLEAR(p.buffers[i].flags, BUFFER_FLAG_OUTSTANDING);
					p.buffers[i].queued = false;
					spa_list_init(&p.buffers[i].link);
				}
			}
		}
		if (first_error < 0)
			return first_error;
		if (!keep_stopping) {
			std::lock_guard<std::mutex> guard(completion_mutex);
			stopping = false;
		}
		return 0;
	}
};

/* Both process() and port_reuse_buffer() run on the data loop.  They must
 * retire before stop() changes provider ownership, but cannot acquire the
 * lifecycle mutex: stop() holds it while synchronously invoking that loop. */
struct process_activity_guard {
	struct impl *self;
	bool stopping;
	explicit process_activity_guard(struct impl *impl)
		: self(impl)
	{
		std::lock_guard<std::mutex> lock(self->completion_mutex);
		++self->processes_inflight;
		stopping = self->stopping;
	}
	process_activity_guard(const process_activity_guard &) = delete;
	process_activity_guard &operator=(const process_activity_guard &) = delete;
	~process_activity_guard()
	{
		std::lock_guard<std::mutex> lock(self->completion_mutex);
		if (self->processes_inflight > 0)
			--self->processes_inflight;
		if (self->processes_inflight == 0)
			self->completion_cv.notify_all();
	}
};

class stopping_transaction_guard {
public:
	explicit stopping_transaction_guard(struct impl *impl)
		: impl_(impl)
	{
	}
	stopping_transaction_guard(const stopping_transaction_guard &) = delete;
	stopping_transaction_guard &operator=(const stopping_transaction_guard &) = delete;

	~stopping_transaction_guard()
	{
		finish();
	}

	void finish()
	{
		if (impl_ == nullptr)
			return;
		std::lock_guard<std::mutex> guard(impl_->completion_mutex);
		impl_->stopping = false;
		impl_ = nullptr;
	}

	/* Leave the lifecycle latch asserted when rollback cannot retire provider
	 * ownership.  The caller may then retry teardown, but no new producer can
	 * race the still-live candidate allocator/configuration. */
	void abandon()
	{
		if (impl_ == nullptr)
			return;
		std::lock_guard<std::mutex> guard(impl_->completion_mutex);
		impl_->stopping = true;
		impl_->active.store(false, std::memory_order_release);
		impl_ = nullptr;
	}

private:
	struct impl *impl_;
};

static int camera_remove_source_on_data_loop(struct impl *self)
{
	if (self == nullptr || self->data_loop == nullptr)
		return -EINVAL;
	if (!self->source.loop) {
		self->source_registered.store(false, std::memory_order_release);
		return 0;
	}
	const int result = spa_loop_remove_source(self->data_loop, &self->source);
	self->source_registered.store(self->source.loop != nullptr,
		std::memory_order_release);
	return result;
}

static int camera_remove_source_invoke(struct spa_loop *, bool, uint32_t,
		const void *, size_t, void *user_data)
{
	return camera_remove_source_on_data_loop(
		static_cast<struct impl *>(user_data));
}

static int camera_add_source_invoke(struct spa_loop *, bool, uint32_t,
		const void *, size_t, void *user_data)
{
	auto *self = static_cast<struct impl *>(user_data);
	if (self == nullptr || self->data_loop == nullptr)
		return -EINVAL;
	if (self->source.loop) {
		self->source_registered.store(true, std::memory_order_release);
		return 0;
	}
	const int result = spa_loop_add_source(self->data_loop, &self->source);
	self->source_registered.store(self->source.loop != nullptr,
		std::memory_order_release);
	return result;
}

