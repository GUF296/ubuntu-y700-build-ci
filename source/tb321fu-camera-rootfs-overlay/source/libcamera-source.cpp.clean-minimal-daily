static int y700_kscreen_rotation_to_ccw_quarters(int rotation)
{
	switch (rotation) {
	case 1: return 0;
	case 2: return 1;
	case 4: return 2;
	case 8: return 3;
	default: return 0;
	}
}

static int y700_calibrated_extra_delta(const struct impl *impl, int rotation)
{
	switch (rotation) {
	case 1:
	case 4:
		return 2;
	case 2:
	case 8:
		return y700_rear_camera(impl) ? 2 : 0;
	default:
		return 0;
	}
}

static bool y700_valid_kscreen_rotation(int rotation)
{
	return rotation == 1 || rotation == 2 || rotation == 4 || rotation == 8;
}

static std::string y700_session_config_dir()
{
	const char *config = std::getenv("XDG_CONFIG_HOME");
	if (config != nullptr && config[0] == '/' && config[1] != '\0')
		return config;

	const char *home = std::getenv("HOME");
	if (home == nullptr || home[0] != '/') {
		if (const struct passwd *pw = getpwuid(getuid()); pw != nullptr)
			home = pw->pw_dir;
	}
	if (home == nullptr || home[0] != '/')
		return {};
	return std::string(home) + "/.config";
}

/* Query the current desktop session without embedding a user id, bus path or
 * display environment in the plugin.  Session selection is inherited from the
 * process that owns the PipeWire node; the fixed executable is run directly. */
static bool y700_parse_kscreen_rotation(const std::string &output, int *rotation)
{
	if (rotation == nullptr)
		return false;

	bool in_dsi = false;
	bool found = false;
	std::size_t line_start = 0;
	while (line_start < output.size()) {
		const std::size_t current_start = line_start;
		const std::size_t newline = output.find('\n', line_start);
		const std::size_t line_end = newline == std::string::npos
			? output.size() : newline;
		line_start = newline == std::string::npos ? output.size() : newline + 1;
		/* Remove ANSI CSI sequences in-place.  kscreen-doctor emits these on
		 * some terminals even when stdout is a pipe. */
		char clean[512];
		size_t out = 0;
		bool escape = false;
		bool csi = false;
		for (std::size_t i = current_start; i < line_end && out + 1 < sizeof(clean); ++i) {
			const unsigned char ch = static_cast<unsigned char>(output[i]);
			if (escape) {
				if (ch == '[') {
					csi = true;
					continue;
				}
				escape = false;
				if (csi) {
					if (ch >= 0x40 && ch <= 0x7e)
						csi = false;
					continue;
				}
			}
			if (ch == 0x1b) {
				escape = true;
				continue;
			}
			if (csi) {
				if (ch >= 0x40 && ch <= 0x7e)
					csi = false;
				continue;
			}
			clean[out++] = static_cast<char>(ch);
		}
		clean[out] = '\0';

		if (std::strstr(clean, "Output:") != nullptr)
			in_dsi = std::strstr(clean, "DSI-1") != nullptr;
		if (!in_dsi || std::strstr(clean, "Rotation:") == nullptr)
			continue;

		const char *value = std::strstr(clean, "Rotation:") + strlen("Rotation:");
		while (*value == ' ' || *value == '\t')
			++value;
		char *end = nullptr;
		errno = 0;
		const long parsed = std::strtol(value, &end, 10);
		while (end != nullptr && (*end == ' ' || *end == '\t' || *end == '\r'))
			++end;
		if (end != value && end != nullptr && *end == '\0' && errno == 0 &&
			parsed >= std::numeric_limits<int>::min() &&
			parsed <= std::numeric_limits<int>::max() &&
			y700_valid_kscreen_rotation(static_cast<int>(parsed))) {
			*rotation = static_cast<int>(parsed);
			found = true;
			break;
		}
	}
	return found;
}

static bool y700_reap_rotation_child(struct impl *impl,
		std::chrono::milliseconds timeout)
{
	if (impl == nullptr || impl->display_rotation_child_pid <= 0)
		return true;
	const pid_t child = impl->display_rotation_child_pid;
	const auto deadline = std::chrono::steady_clock::now() + timeout;
	for (;;) {
		int status = 0;
		const pid_t waited = waitpid(child, &status, WNOHANG);
		if (waited == child || (waited < 0 && errno == ECHILD)) {
			impl->display_rotation_child_pid = -1;
			return true;
		}
		if (waited < 0 && errno != EINTR)
			return false;
		const auto now = std::chrono::steady_clock::now();
		if (now >= deadline)
			return false;
		const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
			deadline - now);
		const int delay = static_cast<int>(
			std::max<int64_t>(1, std::min<int64_t>(10, remaining.count())));
		(void)poll(nullptr, 0, delay);
	}
}

static bool y700_terminate_rotation_child(struct impl *impl)
{
	if (impl == nullptr || impl->display_rotation_child_pid <= 0)
		return true;
	const pid_t child = impl->display_rotation_child_pid;
	if (kill(-child, SIGKILL) < 0 && errno != ESRCH)
		(void)kill(child, SIGKILL);
	return y700_reap_rotation_child(impl, std::chrono::milliseconds(250));
}

static bool y700_query_kscreen_rotation(struct impl *impl, int *rotation)
{
	if (impl == nullptr || rotation == nullptr)
		return false;
	/* A previously killed child is the only permitted outstanding process.
	 * Refuse to create another until it has become waitable and is reaped. */
	if (!y700_reap_rotation_child(impl, std::chrono::milliseconds(0)))
		return false;
	static constexpr std::size_t max_output = 64 * 1024;
	static constexpr auto timeout = std::chrono::seconds(1);
	int pipefd[2] = { -1, -1 };
	if (pipe2(pipefd, O_CLOEXEC) < 0)
		return false;
	for (int &fd : pipefd) {
		if (fd >= 3)
			continue;
		const int replacement = fcntl(fd, F_DUPFD_CLOEXEC, 3);
		if (replacement < 0) {
			close(pipefd[0]);
			close(pipefd[1]);
			return false;
		}
		close(fd);
		fd = replacement;
	}
	const int read_flags = fcntl(pipefd[0], F_GETFL);
	if (read_flags < 0 || fcntl(pipefd[0], F_SETFL, read_flags | O_NONBLOCK) < 0) {
		close(pipefd[0]);
		close(pipefd[1]);
		return false;
	}

	posix_spawn_file_actions_t actions;
	int error = posix_spawn_file_actions_init(&actions);
	if (error != 0) {
		close(pipefd[0]);
		close(pipefd[1]);
		return false;
	}
	if (error == 0)
		error = posix_spawn_file_actions_adddup2(&actions, pipefd[1], STDOUT_FILENO);
	if (error == 0)
		error = posix_spawn_file_actions_addopen(&actions, STDERR_FILENO,
			"/dev/null", O_WRONLY, 0);
	if (error == 0)
		error = posix_spawn_file_actions_addclose(&actions, pipefd[0]);
	if (error == 0)
		error = posix_spawn_file_actions_addclose(&actions, pipefd[1]);

	posix_spawnattr_t attributes;
	bool attributes_initialized = false;
	if (error == 0) {
		error = posix_spawnattr_init(&attributes);
		attributes_initialized = error == 0;
	}
	if (error == 0)
		error = posix_spawnattr_setpgroup(&attributes, 0);
	if (error == 0)
		error = posix_spawnattr_setflags(&attributes, POSIX_SPAWN_SETPGROUP);

	pid_t child = -1;
	if (error == 0) {
		char executable[] = "/usr/bin/kscreen-doctor";
		char option[] = "-o";
		char *argv[] = { executable, option, nullptr };
		error = posix_spawn(&child, executable, &actions, &attributes, argv, environ);
	}
	if (attributes_initialized)
		posix_spawnattr_destroy(&attributes);
	posix_spawn_file_actions_destroy(&actions);
	close(pipefd[1]);
	if (error != 0) {
		close(pipefd[0]);
		return false;
	}
	impl->display_rotation_child_pid = child;

	std::string output;
	output.reserve(4096);
	const auto deadline = std::chrono::steady_clock::now() + timeout;
	bool eof = false;
	bool failed = false;
	bool reaped = false;
	int status = 0;
	while (!eof || !reaped) {
		char block[4096];
		for (;;) {
			const ssize_t count = read(pipefd[0], block, sizeof(block));
			if (count > 0) {
				if (static_cast<std::size_t>(count) > max_output - output.size()) {
					failed = true;
					break;
				}
				output.append(block, static_cast<std::size_t>(count));
				continue;
			}
			if (count == 0) {
				eof = true;
				break;
			}
			if (errno == EINTR)
				continue;
			if (errno != EAGAIN && errno != EWOULDBLOCK)
				failed = true;
			break;
		}

		if (!reaped) {
			pid_t waited;
			do {
				waited = waitpid(child, &status, WNOHANG);
			} while (waited < 0 && errno == EINTR);
			if (waited == child) {
				reaped = true;
				impl->display_rotation_child_pid = -1;
			} else if (waited < 0) {
				if (errno == ECHILD)
					impl->display_rotation_child_pid = -1;
				failed = true;
			}
		}
		if (failed || (eof && reaped))
			break;

		const auto now = std::chrono::steady_clock::now();
		if (now >= deadline) {
			failed = true;
			break;
		}
		const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
			deadline - now);
		struct pollfd pollfd = { pipefd[0], POLLIN | POLLHUP | POLLERR, 0 };
		int poll_result;
		do {
			poll_result = poll(&pollfd, 1,
				static_cast<int>(std::max<int64_t>(1, remaining.count())));
		} while (poll_result < 0 && errno == EINTR);
		if (poll_result < 0)
			failed = true;
	}
	close(pipefd[0]);

	/* Once waitpid() has reaped the child, its numeric PID may be reused
	 * immediately.  Never signal the old process-group ID after that point;
	 * terminate only while this invocation still owns an unreaped child. */
	if (!reaped)
		reaped = y700_terminate_rotation_child(impl);
	return !failed && reaped && WIFEXITED(status) && WEXITSTATUS(status) == 0 &&
		y700_parse_kscreen_rotation(output, rotation);
}

static void y700_display_rotation_watch_reset(struct impl *impl)
{
	if (impl == nullptr)
		return;
	if (impl->display_rotation_inotify_fd >= 0)
		close(impl->display_rotation_inotify_fd);
	impl->display_rotation_inotify_fd = -1;
	impl->display_rotation_inotify_wd = -1;
	impl->display_rotation_config_dir.clear();
}

static void y700_display_rotation_watch_init(struct impl *impl)
{
	if (impl == nullptr || impl->display_rotation_inotify_fd >= 0)
		return;
	impl->display_rotation_config_dir = y700_session_config_dir();
	if (impl->display_rotation_config_dir.empty())
		return;
	const int fd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
	if (fd < 0)
		return;
	const int wd = inotify_add_watch(fd, impl->display_rotation_config_dir.c_str(),
		IN_CLOSE_WRITE | IN_MODIFY | IN_MOVED_TO | IN_CREATE | IN_ATTRIB |
		IN_DELETE_SELF | IN_MOVE_SELF | IN_UNMOUNT);
	if (wd < 0) {
		close(fd);
		impl->display_rotation_config_dir.clear();
		return;
	}
	impl->display_rotation_inotify_fd = fd;
	impl->display_rotation_inotify_wd = wd;
}

static bool y700_display_rotation_watch_changed(struct impl *impl)
{
	if (impl == nullptr || impl->display_rotation_inotify_fd < 0)
		return false;
	char buffer[1024];
	bool changed = false;
	bool invalidated = false;
	for (;;) {
		const ssize_t len = read(impl->display_rotation_inotify_fd, buffer, sizeof(buffer));
		if (len <= 0) {
			if (len < 0 && errno == EINTR)
				continue;
			if (len < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
				break;
			changed = true;
			invalidated = true;
			break;
		}
		size_t offset = 0;
		while (offset + sizeof(struct inotify_event) <= static_cast<size_t>(len)) {
			const auto *event = reinterpret_cast<const struct inotify_event *>(buffer + offset);
			const size_t record = sizeof(struct inotify_event) + event->len;
			if (record > static_cast<size_t>(len) - offset) {
				changed = true;
				invalidated = true;
				break;
			}
			if (event->mask & (IN_Q_OVERFLOW | IN_IGNORED | IN_UNMOUNT |
					IN_DELETE_SELF | IN_MOVE_SELF)) {
				changed = true;
				invalidated = true;
				break;
			}
			if (event->len > 0 &&
				strnlen(event->name, event->len) < event->len &&
				!strcmp(event->name, "kwinoutputconfig.json")) {
				changed = true;
			}
			offset += record;
		}
		if (invalidated)
			break;
	}
	if (invalidated) {
		y700_display_rotation_watch_reset(impl);
		y700_display_rotation_watch_init(impl);
	}
	return changed;
}

static int y700_read_display_rotation(struct impl *impl)
{
	if (impl == nullptr)
		return 1;
	std::lock_guard<std::mutex> lock(impl->rotation_mutex);
	int rotation;

	y700_display_rotation_watch_init(impl);
	if (y700_display_rotation_watch_changed(impl))
		impl->display_rotation_refresh_pending = true;
	if (!impl->display_rotation_initialized)
		impl->display_rotation_refresh_pending = true;
	if (!impl->display_rotation_refresh_pending)
		return impl->display_rotation_cached;

	const auto now = std::chrono::steady_clock::now();
	if (now < impl->display_rotation_retry_after)
		return impl->display_rotation_cached;
	if (y700_query_kscreen_rotation(impl, &rotation)) {
		impl->display_rotation_cached = rotation;
		impl->display_rotation_initialized = true;
		impl->display_rotation_refresh_pending = false;
		impl->display_rotation_retry_after = {};
	} else {
		/* Keep the refresh pending without synchronously retrying on every frame. */
		impl->display_rotation_retry_after = now + std::chrono::seconds(1);
	}
	return impl->display_rotation_cached;
}

static void y700_display_rotation_cleanup(struct impl *impl)
{
	if (impl == nullptr)
		return;
	std::lock_guard<std::mutex> lock(impl->rotation_mutex);
	if (!y700_terminate_rotation_child(impl) && impl->log)
		spa_log_warn(impl->log, "rotation helper did not exit within cleanup bound");
	y700_display_rotation_watch_reset(impl);
	impl->display_rotation_initialized = false;
	impl->display_rotation_refresh_pending = true;
	impl->display_rotation_retry_after = {};
}

static uint32_t y700_rotate_spa_transform(uint32_t transform, int ccw_delta)
{
	if (transform <= SPA_META_TRANSFORMATION_270)
		return (transform + ccw_delta + 4) & 3;
	return transform;
}

static uint32_t y700_effective_spa_transform(struct impl *impl, uint32_t transform)
{
	int display_rotation;
	int display_ccw;

	if (!y700_camera(impl))
		return transform;
	display_rotation = y700_read_display_rotation(impl);
	display_ccw = y700_kscreen_rotation_to_ccw_quarters(display_rotation);
	display_ccw += y700_calibrated_extra_delta(impl, display_rotation);
	return y700_rotate_spa_transform(transform, display_ccw);
}

static void y700_update_videotransform(struct impl *impl, struct buffer *b)
{
	uint32_t transform;
	if (!impl || !impl->config || impl->config->empty() || !b || !b->videotransform)
		return;
	transform = libcamera_orientation_to_spa_transform_value(impl->config->orientation);
	b->videotransform->transform = y700_effective_spa_transform(impl, transform);
}

static int update_chunk_sizes_from_metadata(struct buffer *bound,
		const FrameBuffer *frame_buffer, const FrameMetadata &metadata)
{
	if (bound == nullptr || frame_buffer == nullptr ||
		bound->validated_n_datas == 0 || bound->validated_n_datas > MAX_BUFFERS)
		return -EINVAL;
	const auto frame_planes = frame_buffer->planes();
	const bool payload_valid =
		metadata.status == FrameMetadata::Status::FrameSuccess ||
		metadata.status == FrameMetadata::Status::FrameStartup;
	if (!payload_valid) {
		for (uint32_t i = 0; i < bound->validated_n_datas; ++i) {
			if (bound->validated_chunks[i] == nullptr)
				return -EPROTO;
			bound->validated_chunks[i]->offset = 0;
			bound->validated_chunks[i]->size = 0;
		}
		return 0;
	}

	const auto metadata_planes = metadata.planes();
	if (metadata_planes.size() != frame_planes.size())
		return -EPROTO;
	for (uint32_t i = 0; i < bound->validated_n_datas; ++i) {
		const uint32_t first = bound->first_planes[i];
		const uint32_t count = bound->plane_counts[i];
		if (count == 0 || first >= frame_planes.size() ||
			count > frame_planes.size() - first)
			return -EPROTO;
		const uint64_t map_start = bound->validated_mapoffsets[i];
		const uint64_t map_size = bound->validated_maxsizes[i];
		if (map_start > std::numeric_limits<uint64_t>::max() - map_size)
			return -EOVERFLOW;
		const uint64_t map_end = map_start + map_size;
		uint64_t used_end = map_start;
		for (uint32_t plane_index = first; plane_index < first + count; ++plane_index) {
			const auto &plane = frame_planes[plane_index];
			const uint64_t bytes_used = metadata_planes[plane_index].bytesused;
			if (plane.offset > std::numeric_limits<uint64_t>::max() - plane.length ||
				bytes_used > plane.length)
				return -EOVERFLOW;
			if (bytes_used == 0)
				continue;
			const uint64_t plane_start = plane.offset;
			if (plane_start > std::numeric_limits<uint64_t>::max() - bytes_used)
				return -EOVERFLOW;
			const uint64_t plane_end = plane_start + bytes_used;
			if (plane_start < map_start || plane_end > map_end)
				return -EPROTO;
			used_end = std::max(used_end, plane_end);
		}
		if (used_end < map_start || used_end - map_start >
				std::numeric_limits<uint32_t>::max() ||
			bound->validated_chunks[i] == nullptr)
			return -EOVERFLOW;
		bound->validated_chunks[i]->offset = 0;
		bound->validated_chunks[i]->size = static_cast<uint32_t>(used_end - map_start);
	}
	return 0;
}

static void mark_completion_failure(struct impl *impl, int error)
{
	if (impl == nullptr)
		return;
	if (error >= 0)
		error = -EIO;
	int expected = 0;
	impl->completion_error.compare_exchange_strong(expected, error,
			std::memory_order_release, std::memory_order_relaxed);
	impl->active.store(false, std::memory_order_release);
}

static void recycle_completed_request(struct impl *impl, struct port *port,
		struct buffer *b, libcamera::Request *request)
{
	if (request == nullptr)
		return;
	request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
	if (impl == nullptr)
		return;

	/* Never queue a request whose ownership cannot be authenticated.  A
	 * malformed cookie/pointer must terminate the stream rather than allowing
	 * an arbitrary Request object back into libcamera's queue. */
	if (port == nullptr || b == nullptr) {
		mark_completion_failure(impl, -EPROTO);
		return;
	}

	if (b->id >= port->n_buffers || b->id >= impl->requestPool.size() ||
		impl->requestPool[b->id].get() != request) {
		mark_completion_failure(impl, -EINVAL);
		return;
	}

	/* Mark it outstanding before using the normal queue path so inactive and
	 * queue-failure cases retain coherent ownership. */
	SPA_FLAG_SET(b->flags, BUFFER_FLAG_OUTSTANDING);
	const int res = recycle_buffer_locked(impl, port, b->id);
	if (res < 0) {
		mark_completion_failure(impl, res);
		if (impl->log)
			spa_log_warn(impl->log, "can't recycle malformed camera buffer %u: %s",
				b->id, spa_strerror(res));
	}
}

void handle_completed_request(struct impl *impl, libcamera::Request *request)
{
	if (request == nullptr)
		return;
	if (impl == nullptr) {
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		return;
	}
	std::unique_lock<std::mutex> buffer_guard(impl->buffer_mutex);
	if (!impl->active.load(std::memory_order_acquire)) {
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		return;
	}
	const auto request_id = request->cookie();
	struct port *port = &impl->out_ports[0];
	if (request_id >= MAX_BUFFERS || request_id >= port->n_buffers ||
		request_id >= impl->requestPool.size() ||
		impl->requestPool[request_id].get() != request) {
		spa_log_warn(impl->log, "ignoring completion with invalid cookie %" PRIu64,
				request_id);
		/* Reuse releases libcamera's completed state, but the unauthenticated
		 * request is deliberately not requeued.  The stream is terminal until
		 * the owner performs a full stop/restart. */
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(impl, -EPROTO);
		return;
	}
	buffer *b = &port->buffers[request_id];

	spa_log_trace(impl->log, "%p: request %p[%" PRIu64 "] process status:%u seq:%" PRIu32,
			impl, request, request_id, static_cast<unsigned int>(request->status()),
			request->sequence());

	if (request->status() == libcamera::Request::Status::RequestCancelled) {
		spa_log_trace(impl->log, "%p: request %p[%" PRIu64 "] cancelled",
				impl, request, request_id);
		recycle_completed_request(impl, port, b, request);
		return;
	}

	/* The caller-owned graph is authenticated once during allocation. Never
	 * trust a changed count or data pointer in this asynchronous path. */
	if (b->outbuf == nullptr || b->validated_datas == nullptr ||
		b->validated_n_datas == 0 ||
		b->outbuf->metas != b->validated_metas ||
		b->outbuf->n_metas != b->validated_n_metas ||
		b->outbuf->datas != b->validated_datas ||
		b->outbuf->n_datas != b->validated_n_datas) {
		spa_log_warn(impl->log, "camera buffer %" PRIu64 " changed its data graph",
				request_id);
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(impl, -EPROTO);
		return;
	}
	bool graph_changed =
		spa_buffer_find_meta_data(b->outbuf, SPA_META_Header, sizeof(*b->h)) != b->h ||
		spa_buffer_find_meta_data(b->outbuf, SPA_META_VideoTransform,
			sizeof(*b->videotransform)) != b->videotransform;
		for (uint32_t i = 0; i < b->validated_n_datas; ++i) {
			const struct spa_data &data = b->validated_datas[i];
			graph_changed = graph_changed || data.chunk == nullptr ||
				data.chunk != b->validated_chunks[i] ||
			data.type != b->validated_types[i] ||
			data.flags != b->validated_flags[i] ||
				data.fd != b->validated_fds[i] ||
				data.mapoffset != b->validated_mapoffsets[i] ||
				data.maxsize != b->validated_maxsizes[i] ||
				data.chunk->stride != b->validated_strides[i] ||
				data.chunk->offset > data.maxsize ||
				data.chunk->size > data.maxsize - data.chunk->offset;
	}
	if (graph_changed) {
		spa_log_warn(impl->log, "camera buffer %" PRIu64 " changed its bound graph",
				request_id);
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(impl, -EPROTO);
		return;
	}

	Stream *stream = port->streamConfig.stream();
	if (stream == nullptr) {
		spa_log_warn(impl->log, "%p: completion has no configured stream", request);
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(impl, -EIO);
		return;
	}
	const FrameBuffer *buffer = request->findBuffer(stream);
	if (buffer == nullptr) {
		spa_log_warn(impl->log, "%p: request %p[%" PRIu64 "] has no buffer for stream %p",
				impl, request, request_id, stream);
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(impl, -EPROTO);
		return;
	}

	const FrameMetadata &fmd = buffer->metadata();
	const int chunk_size_res = update_chunk_sizes_from_metadata(b, buffer, fmd);
	if (chunk_size_res < 0) {
		spa_log_warn(impl->log,
			"camera buffer %" PRIu64 " has invalid per-plane bytesused metadata: %s",
			request_id, spa_strerror(chunk_size_res));
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(impl, chunk_size_res);
		return;
	}

	if (impl->clock) {
		const struct spa_fraction rate = framerate_valid(&port->rate)
			? port->rate : defaultClockRate;
		if (!framerate_valid(&port->info.rate))
			port->info.rate = SPA_FRACTION(rate.num, rate.denom);
		double target = (double)rate.num / rate.denom;
		double corr;

		if (impl->dll.bw == 0.0) {
			spa_dll_set_bw(&impl->dll, SPA_DLL_BW_MAX, rate.num, rate.denom);
			impl->clock->next_nsec = fmd.timestamp;
			corr = 1.0;
		} else {
			double diff = ((double)impl->clock->next_nsec - (double)fmd.timestamp) / SPA_NSEC_PER_SEC;
			double error = rate.denom * (diff - target);
			corr = spa_dll_update(&impl->dll, SPA_CLAMPD(error, -128., 128.));
		}
		/* FIXME, we should follow the driver clock and target_ values.
		 * for now we ignore and use our own. */
		impl->clock->target_rate = port->rate;
		impl->clock->target_duration = 1;

		impl->clock->nsec = fmd.timestamp;
		impl->clock->rate = port->rate;
		impl->clock->position = fmd.sequence;
		impl->clock->duration = 1;
		impl->clock->delay = 0;
		impl->clock->rate_diff = corr;
		uint64_t next_nsec;
		if (!checked_next_timestamp(impl->clock->next_nsec, rate, corr,
				&next_nsec)) {
			spa_log_error(impl->log, "invalid camera clock correction/rate");
			request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
			mark_completion_failure(impl, -ERANGE);
			return;
		}
		impl->clock->next_nsec = next_nsec;
	}

	y700_update_videotransform(impl, b);
	if (b->h) {
		b->h->flags = 0;
		if (fmd.status != libcamera::FrameMetadata::Status::FrameSuccess)
			b->h->flags |= SPA_META_HEADER_FLAG_CORRUPTED;
		b->h->offset = 0;
		b->h->seq = fmd.sequence;
		b->h->pts = fmd.timestamp;
		b->h->dts_offset = 0;
	}

	for (uint32_t i = 0; i < b->validated_n_datas; i++) {
		auto *d = &b->validated_datas[i];
		d->chunk->flags = 0;

		if (fmd.status != libcamera::FrameMetadata::Status::FrameSuccess)
			d->chunk->flags |= SPA_CHUNK_FLAG_CORRUPTED;
	}
	if (b->queued) {
		/* A duplicate completion would otherwise insert the same list node
		 * twice and corrupt the PipeWire queue. */
		spa_log_error(impl->log, "duplicate completion for camera buffer %" PRIu64,
				request_id);
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(impl, -EALREADY);
		return;
	}

	request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);

	spa_list_append(&port->queue, &b->link);
	b->queued = true;

	spa_io_buffers *io = port->io;
	if (io == nullptr) {
		b = spa_list_first(&port->queue, struct buffer, link);
		spa_list_remove(&b->link);
		b->queued = false;
		spa_list_init(&b->link);
		SPA_FLAG_SET(b->flags, BUFFER_FLAG_OUTSTANDING);
		if (recycle_buffer_locked(impl, port, b->id) < 0)
			mark_completion_failure(impl, -EIO);
	} else if (io->status != SPA_STATUS_HAVE_DATA) {
		if (io->buffer_id < port->n_buffers &&
			recycle_buffer_locked(impl, port, io->buffer_id) < 0)
			mark_completion_failure(impl, -EIO);

		b = spa_list_first(&port->queue, struct buffer, link);
		spa_list_remove(&b->link);
		b->queued = false;
		spa_list_init(&b->link);
		SPA_FLAG_SET(b->flags, BUFFER_FLAG_OUTSTANDING);

		io->buffer_id = b->id;
		io->status = SPA_STATUS_HAVE_DATA;
		spa_log_trace(impl->log, "%p: now queued %" PRIu32, impl, b->id);
	}

	buffer_guard.unlock();
	std::lock_guard<std::recursive_mutex> callbacks_guard(impl->callbacks_mutex);
	spa_node_call_ready(&impl->callbacks, SPA_STATUS_HAVE_DATA);
}

void libcamera_on_fd_events(struct spa_source *source)
{
	if (source == nullptr || source->data == nullptr)
		return;
	struct impl *impl = (struct impl*) source->data;
	{
		std::lock_guard<std::mutex> lock(impl->completion_mutex);
		++impl->callbacks_inflight;
	}
	struct callback_guard {
		struct impl *self;
		~callback_guard()
		{
			std::lock_guard<std::mutex> lock(self->completion_mutex);
			if (self->callbacks_inflight > 0)
				--self->callbacks_inflight;
			if (self->callbacks_inflight == 0)
				self->completion_cv.notify_all();
		}
	} activity{impl};
	std::array<libcamera::Request *, COMPLETION_RING_SIZE> ready{};
	std::size_t ready_count = 0;
	bool remove_source = false;
	bool retire_completion_source = false;
	bool stopping = false;

	{
		std::lock_guard<std::mutex> guard(impl->completion_mutex);
		const bool terminal =
			impl->completion_error.load(std::memory_order_acquire) < 0;
		stopping = impl->stopping;
		if (stopping) {
			retire_completion_source = impl->data_loop != nullptr &&
				impl->source_registered.load(std::memory_order_acquire);
		} else if (!impl->active.load(std::memory_order_acquire) && !terminal) {
			return;
		} else if (source->rmask & SPA_IO_ERR) {
			spa_log_error(impl->log, "libcamera %p: error %08x", impl, source->rmask);
			mark_completion_failure(impl, -EIO);
			remove_source = true;
		} else if (!(source->rmask & SPA_IO_IN)) {
			spa_log_warn(impl->log, "libcamera %p: spurious wakeup %d", impl, source->rmask);
			return;
		} else if (impl->system == nullptr ||
			impl->source_fd.load(std::memory_order_acquire) < 0) {
			mark_completion_failure(impl, -EIO);
			remove_source = true;
		} else {
			uint64_t cnt = 0;
			const int source_fd = impl->source_fd.load(std::memory_order_acquire);
			if (source_fd < 0) {
				mark_completion_failure(impl, -EIO);
				remove_source = true;
			} else if (spa_system_eventfd_read(impl->system, source_fd, &cnt) < 0) {
				if (errno == EAGAIN || errno == EWOULDBLOCK)
					return;
				spa_log_error(impl->log, "Failed to read on event fd");
				mark_completion_failure(impl, -errno);
				remove_source = true;
			} else {
				uint32_t index = 0;
				const auto avail = spa_ringbuffer_get_read_index(
					&impl->completed_requests_rb, &index);
				if (avail < 0 || avail > COMPLETION_RING_SIZE) {
					mark_completion_failure(impl, -EOVERFLOW);
					remove_source = true;
				} else {
					for (int32_t left = avail; left > 0 &&
						ready_count < ready.size(); --left, ++index) {
						ready[ready_count++] =
							impl->completed_requests[index & COMPLETION_RING_MASK];
						impl->completed_requests[index & COMPLETION_RING_MASK] = nullptr;
						spa_ringbuffer_read_update(&impl->completed_requests_rb, index + 1);
					}
				}
			}
		}
	}

	/* A failed stop-side invoke can leave a readable source registered.  This
	 * callback already runs on data_loop, and its activity guard keeps impl
	 * alive while the source is retired without completion_mutex held. */
	if (stopping) {
		if (retire_completion_source)
			(void)camera_remove_source_on_data_loop(impl);
		return;
	}

	for (std::size_t i = 0; i < ready_count; ++i)
		handle_completed_request(impl, ready[i]);

	if (remove_source || impl->completion_error.load(std::memory_order_acquire) != 0) {
		{
			std::lock_guard<std::mutex> lock(impl->completion_mutex);
			retire_completion_source = !impl->stopping &&
				impl->data_loop != nullptr &&
				impl->source_registered.load(std::memory_order_acquire);
		}
		/* This callback already runs on data_loop.  Retire the source only after
		 * releasing completion_mutex: source removal may synchronously enter loop
		 * bookkeeping, while stop() needs the same mutex to observe this callback's
		 * activity guard.  The guard keeps impl alive through the unlocked call. */
		if (retire_completion_source)
			(void)camera_remove_source_on_data_loop(impl);
	}
}

const struct {
	Orientation libcamera_orientation; /* clockwise rotation then horizontal mirroring */
	uint32_t spa_transform_value; /* horizontal mirroring then counter-clockwise rotation */
} orientation_map[] = {
	{ Orientation::Rotate0, SPA_META_TRANSFORMATION_None },
	{ Orientation::Rotate0Mirror, SPA_META_TRANSFORMATION_Flipped },
	{ Orientation::Rotate90, SPA_META_TRANSFORMATION_270 },
	{ Orientation::Rotate90Mirror, SPA_META_TRANSFORMATION_Flipped90 },
	{ Orientation::Rotate180, SPA_META_TRANSFORMATION_180 },
	{ Orientation::Rotate180Mirror, SPA_META_TRANSFORMATION_Flipped180 },
	{ Orientation::Rotate270, SPA_META_TRANSFORMATION_90 },
	{ Orientation::Rotate270Mirror, SPA_META_TRANSFORMATION_Flipped270 },
};

uint32_t libcamera_orientation_to_spa_transform_value(Orientation orientation)
{
	for (const auto& t : orientation_map) {
		if (t.libcamera_orientation == orientation)
			return t.spa_transform_value;
	}
	return SPA_META_TRANSFORMATION_None;
}

static uint32_t choose_spa_memtype(uint32_t type)
{
	if (type == SPA_ID_INVALID)
		return SPA_DATA_DmaBuf;
	if (type == SPA_DATA_DmaBuf)
		return SPA_DATA_DmaBuf;
	/* spa_data.type is an ID, not a bit mask.  Accepting arbitrary values that
	 * happen to contain the DmaBuf bit would publish a mapping contract the
	 * allocator never negotiated.  libcamera exports only exact DMA-BUF IDs. */
	return SPA_DATA_Invalid;
}

struct buffer_graph_range {
	std::uintptr_t begin = 0;
	std::uintptr_t end = 0;
};

static constexpr std::size_t MAX_BUFFER_GRAPH_RANGES =
	1 + MAX_BUFFERS * (5 + MAX_BUFFERS);

struct buffer_graph_manifest {
	std::array<buffer_graph_range, MAX_BUFFER_GRAPH_RANGES> ranges{};
	std::size_t count = 0;
};

static int add_buffer_graph_range(buffer_graph_manifest *manifest,
		const void *pointer, std::size_t size, std::size_t alignment)
{
	if (manifest == nullptr || pointer == nullptr || size == 0 || alignment == 0)
		return -EINVAL;
	const auto begin = reinterpret_cast<std::uintptr_t>(pointer);
	if (begin % alignment != 0 || size > std::numeric_limits<std::uintptr_t>::max() - begin)
		return -EOVERFLOW;
	const auto end = begin + size;
	for (std::size_t i = 0; i < manifest->count; ++i) {
		const auto &range = manifest->ranges[i];
		if (begin < range.end && range.begin < end)
			return -EINVAL;
	}
	if (manifest->count >= manifest->ranges.size())
		return -EOVERFLOW;
	manifest->ranges[manifest->count++] = { begin, end };
	return 0;
}

static bool buffer_graph_manifests_overlap(const buffer_graph_manifest &left,
		const buffer_graph_manifest &right)
{
	for (std::size_t i = 0; i < left.count; ++i) {
		for (std::size_t j = 0; j < right.count; ++j) {
			if (left.ranges[i].begin < right.ranges[j].end &&
				right.ranges[j].begin < left.ranges[i].end)
				return true;
		}
	}
	return false;
}

enum class registered_io_slot {
	none,
	clock,
	position,
	buffers,
	control,
};

static int add_registered_io_range(buffer_graph_manifest *manifest,
		const void *pointer, std::size_t size, std::size_t alignment)
{
	if (pointer == nullptr)
		return 0;
	if (size < alignment)
		return -EPROTO;
	return add_buffer_graph_range(manifest, pointer, size, alignment);
}

/* The node writes clock/buffer IO from completion and process callbacks.  Keep
 * every registered IO range separate from the caller-owned buffer graph and
 * from the other IO objects, regardless of registration order. */
static int build_registered_io_manifest_locked(const struct impl *impl,
		const struct port *port, buffer_graph_manifest *manifest,
		registered_io_slot skip = registered_io_slot::none)
{
	if (impl == nullptr || port == nullptr || manifest == nullptr)
		return -EINVAL;
	*manifest = {};
	int res;
	if (skip != registered_io_slot::clock && impl->clock != nullptr) {
		const std::size_t size = impl->clock_size != 0
			? impl->clock_size : sizeof(*impl->clock);
		if ((res = add_registered_io_range(manifest, impl->clock, size,
				alignof(struct spa_io_clock))) < 0)
			return res;
	}
	if (skip != registered_io_slot::position && impl->position != nullptr) {
		const std::size_t size = impl->position_size != 0
			? impl->position_size : sizeof(*impl->position);
		if ((res = add_registered_io_range(manifest, impl->position, size,
				alignof(struct spa_io_position))) < 0)
			return res;
	}
	if (skip != registered_io_slot::buffers && port->io != nullptr) {
		const std::size_t size = port->io_size != 0
			? port->io_size : sizeof(*port->io);
		if ((res = add_registered_io_range(manifest, port->io, size,
				alignof(struct spa_io_buffers))) < 0)
			return res;
	}
	if (skip != registered_io_slot::control && port->control != nullptr) {
		if (port->control_size < sizeof(*port->control))
			return -EPROTO;
		if ((res = add_registered_io_range(manifest, port->control,
				port->control_size, alignof(struct spa_io_sequence))) < 0)
			return res;
	}
	return 0;
}

static int reject_buffer_graph_io_overlap(
		const buffer_graph_manifest &graph, const struct impl *impl,
		const struct port *port)
{
	buffer_graph_manifest io_manifest{};
	const int res = build_registered_io_manifest_locked(impl, port, &io_manifest);
	if (res < 0)
		return res;
	return buffer_graph_manifests_overlap(graph, io_manifest) ? -EINVAL : 0;
}

static int build_bound_buffer_graph_manifest_locked(const struct impl *impl,
		const struct port *port, buffer_graph_manifest *manifest)
{
	if (impl == nullptr || port == nullptr || manifest == nullptr ||
		port->n_buffers > MAX_BUFFERS ||
		!bound_spa_buffer_graph_matches_locked(port))
		return -EPROTO;
	*manifest = {};
	for (uint32_t i = 0; i < port->n_buffers; ++i) {
		const struct buffer &bound = port->buffers[i];
		int res = add_buffer_graph_range(manifest, bound.outbuf,
			sizeof(*bound.outbuf), alignof(struct spa_buffer));
		if (res < 0)
			return res;
		res = add_buffer_graph_range(manifest, bound.validated_datas,
			bound.validated_n_datas * sizeof(*bound.validated_datas),
			alignof(struct spa_data));
		if (res < 0)
			return res;
		if (bound.validated_n_metas > 0) {
			res = add_buffer_graph_range(manifest, bound.validated_metas,
				bound.validated_n_metas * sizeof(*bound.validated_metas),
				alignof(struct spa_meta));
			if (res < 0)
				return res;
		}
		for (uint32_t j = 0; j < bound.validated_n_datas; ++j) {
			res = add_buffer_graph_range(manifest, bound.validated_chunks[j],
				sizeof(*bound.validated_chunks[j]), alignof(struct spa_chunk));
			if (res < 0)
				return res;
		}
		if (bound.h != nullptr) {
			res = add_buffer_graph_range(manifest, bound.h, sizeof(*bound.h),
				alignof(struct spa_meta_header));
			if (res < 0)
				return res;
		}
		if (bound.videotransform != nullptr) {
			res = add_buffer_graph_range(manifest, bound.videotransform,
				sizeof(*bound.videotransform), alignof(struct spa_meta_videotransform));
			if (res < 0)
				return res;
		}
	}
	return 0;
}

static int validate_io_registration_locked(const struct impl *impl,
		const struct port *port, registered_io_slot slot, const void *pointer,
		std::size_t size, std::size_t alignment)
{
	if (impl == nullptr || port == nullptr)
		return -EINVAL;
	buffer_graph_manifest io_manifest{};
	int res = build_registered_io_manifest_locked(impl, port, &io_manifest, slot);
	if (res < 0)
		return res;
	res = add_registered_io_range(&io_manifest, pointer, size, alignment);
	if (res < 0)
		return res;
	buffer_graph_manifest bound_manifest{};
	res = build_bound_buffer_graph_manifest_locked(impl, port, &bound_manifest);
	if (res < 0)
		return res;
	return buffer_graph_manifests_overlap(io_manifest, bound_manifest)
		? -EINVAL : 0;
}

static unsigned int plane_height(const StreamConfiguration &config,
		uint32_t plane_index)
{
	if (plane_index == 0)
		return config.size.height;
	const PixelFormat &format = config.pixelFormat;
	if (format == formats::NV12 || format == formats::NV21 ||
		format == formats::YUV420 || format == formats::YVU420)
		return (config.size.height + 1) / 2;
	if (format == formats::NV16 || format == formats::NV61 ||
		format == formats::NV24 || format == formats::YUV422)
		return config.size.height;
	return 0;
}

static int derive_plane_stride(const StreamConfiguration &config,
		libcamera::Span<const libcamera::FrameBuffer::Plane> planes,
		uint32_t plane_index, uint32_t *stride)
{
	if (stride == nullptr || plane_index >= planes.size())
		return -EINVAL;
	if (plane_index == 0) {
		*stride = config.stride;
		return 0;
	}
	const unsigned int height = plane_height(config, plane_index);
	if (height == 0 || planes[plane_index].length % height != 0)
		return -ENOTSUP;
	const uint64_t value = planes[plane_index].length / height;
	if (value == 0 || value > static_cast<uint64_t>(std::numeric_limits<int32_t>::max()))
		return -EOVERFLOW;
	*stride = static_cast<uint32_t>(value);
	return 0;
}

/* A grouped spa_data exposes one stride for every plane sharing its FD.
 * Reject layouts whose planes need different row pitches instead of silently
 * publishing the first plane's stride for the rest of the group. */
static int derive_group_stride(const StreamConfiguration &config,
		libcamera::Span<const libcamera::FrameBuffer::Plane> planes,
		uint32_t first_plane, uint32_t plane_count, uint32_t *stride)
{
	if (stride == nullptr || plane_count == 0 || first_plane >= planes.size() ||
		plane_count > planes.size() - first_plane)
		return -EINVAL;
	uint32_t group_stride = 0;
	for (uint32_t index = first_plane; index < first_plane + plane_count; ++index) {
		uint32_t plane_stride = 0;
		const int res = derive_plane_stride(config, planes, index, &plane_stride);
		if (res < 0)
			return res;
		if (index == first_plane)
			group_stride = plane_stride;
		else if (plane_stride != group_stride)
			return -ENOTSUP;
	}
	*stride = group_stride;
	return 0;
}

struct spa_data_binding_plan {
	int fd = -1;
	uint32_t offset = 0;
	uint32_t size = 0;
	uint32_t stride = 0;
	uint32_t first_plane = 0;
	uint32_t plane_count = 0;
	uint32_t memtype = SPA_DATA_Invalid;
};

struct spa_buffer_binding_plan {
	uint32_t n_datas = 0;
	std::array<spa_data_binding_plan, MAX_BUFFERS> datas{};
};

using spa_buffer_graph_plan =
	std::array<spa_buffer_binding_plan, MAX_BUFFERS>;

static int validate_spa_buffer_graph_locked(struct impl *impl, struct port *port,
			struct spa_buffer **buffers, uint32_t n_buffers,
			spa_buffer_graph_plan *plan, buffer_graph_manifest *manifest)
{
	if (impl == nullptr || port == nullptr || buffers == nullptr ||
		n_buffers == 0 || n_buffers > MAX_BUFFERS)
		return -EINVAL;
	if (!impl->config || impl->config->empty() || !impl->allocator.allocated())
		return -EIO;
	if (port->streamConfig.stride >
		static_cast<unsigned int>(std::numeric_limits<int32_t>::max()))
		return -EOVERFLOW;

	Stream *stream = impl->config->at(0).stream();
	if (stream == nullptr || stream != port->streamConfig.stream())
		return -EIO;
	const auto &bufs = impl->allocator.buffers(stream);
	if (bufs.size() != n_buffers)
		return -EINVAL;
	if (plan != nullptr)
		plan->fill(spa_buffer_binding_plan{});
	buffer_graph_manifest local_manifest{};
	buffer_graph_manifest *candidate_manifest = manifest != nullptr ? manifest : &local_manifest;
	*candidate_manifest = {};
	buffer_graph_manifest io_manifest{};
	int io_res = build_registered_io_manifest_locked(impl, port, &io_manifest);
	if (io_res < 0)
		return io_res;
	auto add_graph_range = [&](const void *pointer, std::size_t size,
			std::size_t alignment) -> int {
		int res = add_buffer_graph_range(candidate_manifest, pointer, size, alignment);
		if (res < 0)
			return res;
		return buffer_graph_manifests_overlap(*candidate_manifest, io_manifest)
			? -EINVAL : 0;
	};
	int manifest_res = add_graph_range(buffers,
		n_buffers * sizeof(*buffers), alignof(struct spa_buffer *));
	if (manifest_res < 0)
		return manifest_res;

	std::size_t expected_plane_count = 0;
	uint32_t expected_data_count = 0;
	for (uint32_t i = 0; i < n_buffers; ++i) {
		if (!bufs[i]) {
			spa_log_error(impl->log, "missing libcamera buffer at index %u", i);
			return -EINVAL;
		}
		const auto &planes = bufs[i]->planes();
		if (planes.empty() || planes.size() > MAX_BUFFERS) {
			spa_log_error(impl->log, "invalid libcamera planes at index %u", i);
			return -EINVAL;
		}
		if (buffers[i] == nullptr) {
			spa_log_error(impl->log, "invalid buffer data at index %u", i);
			return -EINVAL;
		}
		manifest_res = add_graph_range(buffers[i],
			sizeof(*buffers[i]), alignof(struct spa_buffer));
		if (manifest_res < 0)
			return manifest_res;
		if ((buffers[i]->n_metas > 0 && buffers[i]->metas == nullptr) ||
			buffers[i]->n_metas > MAX_BUFFERS || buffers[i]->datas == nullptr ||
			buffers[i]->n_datas < 1 || buffers[i]->n_datas > MAX_BUFFERS) {
			spa_log_error(impl->log, "invalid buffer data at index %u", i);
			return -EINVAL;
		}
		manifest_res = add_graph_range(buffers[i]->datas,
			buffers[i]->n_datas * sizeof(*buffers[i]->datas), alignof(struct spa_data));
		if (manifest_res < 0)
			return manifest_res;
		if (buffers[i]->n_metas > 0) {
			manifest_res = add_graph_range(buffers[i]->metas,
				buffers[i]->n_metas * sizeof(*buffers[i]->metas),
				alignof(struct spa_meta));
			if (manifest_res < 0)
				return manifest_res;
		}
		if (i == 0) {
			expected_plane_count = planes.size();
			expected_data_count = buffers[i]->n_datas;
		} else if (planes.size() != expected_plane_count ||
			buffers[i]->n_datas != expected_data_count) {
			spa_log_error(impl->log, "inconsistent camera buffer layout at index %u", i);
			return -EINVAL;
		}
		std::array<plane_group_binding, MAX_BUFFERS> groups{};
		std::size_t group_count = 0;
		const int group_res = build_plane_groups(planes, &groups, &group_count);
		if (group_res < 0)
			return group_res;
		if (group_count != port->buffers_blocks)
			return -EIO;
		const bool plane_per_data = buffers[i]->n_datas == planes.size();
		const bool group_per_data = buffers[i]->n_datas == group_count;
		if (!plane_per_data && !group_per_data) {
			spa_log_error(impl->log,
				"buffer %u has %u SPA datas for %zu planes/%zu fd groups",
				i, buffers[i]->n_datas, planes.size(), group_count);
			return -EINVAL;
		}

		spa_buffer_binding_plan *buffer_plan = plan != nullptr ? &(*plan)[i] : nullptr;
		if (buffer_plan != nullptr)
			buffer_plan->n_datas = buffers[i]->n_datas;
		for (uint32_t j = 0; j < buffers[i]->n_datas; ++j) {
			if (buffers[i]->datas[j].chunk == nullptr) {
				spa_log_error(impl->log, "invalid buffer chunk at index %u/%u", i, j);
				return -EINVAL;
			}
			manifest_res = add_graph_range(
				buffers[i]->datas[j].chunk, sizeof(*buffers[i]->datas[j].chunk),
				alignof(struct spa_chunk));
			if (manifest_res < 0)
				return manifest_res;
			const uint32_t memtype = choose_spa_memtype(buffers[i]->datas[j].type);
			if (memtype == SPA_DATA_Invalid) {
				spa_log_error(impl->log, "can't use buffers of type %" PRIu32,
						buffers[i]->datas[j].type);
				return -EINVAL;
			}
			spa_data_binding_plan binding{};
			binding.memtype = memtype;
			if (plane_per_data) {
				binding.fd = planes[j].fd.get();
				binding.offset = static_cast<uint32_t>(planes[j].offset);
				binding.size = static_cast<uint32_t>(planes[j].length);
				binding.first_plane = j;
				binding.plane_count = 1;
			} else {
				binding.fd = groups[j].fd;
				binding.offset = groups[j].offset;
				binding.size = groups[j].size;
				binding.first_plane = groups[j].first_plane;
				binding.plane_count = groups[j].plane_count;
			}
			const int stride_res = binding.plane_count > 1
				? derive_group_stride(port->streamConfig, planes,
					binding.first_plane, binding.plane_count, &binding.stride)
				: derive_plane_stride(port->streamConfig, planes,
					binding.first_plane, &binding.stride);
			if (stride_res < 0)
				return stride_res;
			if (buffer_plan != nullptr)
				buffer_plan->datas[j] = binding;
		}
		auto *header = static_cast<struct spa_meta_header *>(spa_buffer_find_meta_data(
			buffers[i], SPA_META_Header, sizeof(struct spa_meta_header)));
		if (header != nullptr) {
			manifest_res = add_graph_range(header,
				sizeof(*header), alignof(struct spa_meta_header));
			if (manifest_res < 0)
				return manifest_res;
		}
		auto *videotransform = static_cast<struct spa_meta_videotransform *>(
			spa_buffer_find_meta_data(buffers[i], SPA_META_VideoTransform,
					sizeof(struct spa_meta_videotransform)));
		if (videotransform != nullptr) {
			manifest_res = add_graph_range(videotransform,
				sizeof(*videotransform), alignof(struct spa_meta_videotransform));
			if (manifest_res < 0)
				return manifest_res;
		}
	}
	return buffer_graph_manifests_overlap(*candidate_manifest, io_manifest)
		? -EINVAL : 0;
}

static void bind_spa_buffer_graph_validated_locked(struct impl *impl, struct port *port,
			struct spa_buffer **buffers, uint32_t n_buffers,
			const spa_buffer_graph_plan &plan)
{
	spa_list_init(&port->queue);
	for (uint32_t i = 0; i < n_buffers; ++i) {
		struct buffer *b = &port->buffers[i];

		*b = buffer{};
		b->id = i;
		spa_list_init(&b->link);
		b->outbuf = buffers[i];
		b->validated_metas = buffers[i]->metas;
		b->validated_n_metas = buffers[i]->n_metas;
		b->validated_datas = buffers[i]->datas;
		b->validated_n_datas = buffers[i]->n_datas;
		for (uint32_t j = 0; j < b->validated_n_datas; ++j)
			b->validated_chunks[j] = b->validated_datas[j].chunk;
		b->h = (struct spa_meta_header *)spa_buffer_find_meta_data(
			buffers[i], SPA_META_Header, sizeof(*b->h));
		b->videotransform = (struct spa_meta_videotransform *)spa_buffer_find_meta_data(
			buffers[i], SPA_META_VideoTransform, sizeof(*b->videotransform));
		if (b->videotransform)
			y700_update_videotransform(impl, b);

		spa_data *data = buffers[i]->datas;
		for (uint32_t j = 0; j < buffers[i]->n_datas; ++j) {
			const auto &binding = plan[i].datas[j];
			data[j].type = binding.memtype;
			data[j].flags = SPA_DATA_FLAG_READABLE | SPA_DATA_FLAG_MAPPABLE;
			data[j].fd = binding.fd;
			data[j].mapoffset = binding.offset;
			data[j].data = nullptr;
				data[j].chunk->stride = static_cast<int32_t>(binding.stride);
			data[j].chunk->flags = 0;
			data[j].maxsize = binding.size;
			data[j].chunk->size = binding.size;
			data[j].chunk->offset = 0;
			b->validated_types[j] = data[j].type;
			b->validated_flags[j] = data[j].flags;
			b->validated_fds[j] = data[j].fd;
			b->validated_mapoffsets[j] = data[j].mapoffset;
				b->validated_maxsizes[j] = data[j].maxsize;
				b->validated_strides[j] = data[j].chunk->stride;
			b->first_planes[j] = binding.first_plane;
			b->plane_counts[j] = binding.plane_count;
		}
	}
	port->n_buffers = n_buffers;
	spa_log_debug(impl->log, "we have %u buffers", n_buffers);
}

static int spa_libcamera_rebind_buffers(struct impl *impl, struct port *port,
		struct spa_buffer **buffers, uint32_t n_buffers)
{
	if (impl == nullptr)
		return -EINVAL;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	std::lock_guard<std::mutex> buffer_guard(impl->buffer_mutex);
	if (port == nullptr || port->n_buffers != n_buffers)
		return -EINVAL;
	spa_buffer_graph_plan plan{};
	const int validation = validate_spa_buffer_graph_locked(impl, port, buffers,
			n_buffers, &plan, nullptr);
	if (validation < 0)
		return validation;
	bind_spa_buffer_graph_validated_locked(impl, port, buffers, n_buffers, plan);
	return 0;
}

void impl::requestComplete(libcamera::Request *request)
{
	if (request == nullptr)
		return;

	/* Disconnecting a libcamera signal does not by itself provide a join with
	 * a callback that has already started.  Keep explicit activity custody so
	 * stop() cannot close the eventfd or destroy requests underneath us. */
	{
		std::lock_guard<std::mutex> lock(completion_mutex);
		++callbacks_inflight;
	}
	struct callback_guard {
		struct impl *self;
		~callback_guard()
		{
			std::lock_guard<std::mutex> lock(self->completion_mutex);
			if (self->callbacks_inflight > 0)
				--self->callbacks_inflight;
			if (self->callbacks_inflight == 0)
				self->completion_cv.notify_all();
		}
	} guard{this};

	std::lock_guard<std::mutex> lock(completion_mutex);
	if (stopping || !active.load(std::memory_order_acquire) ||
		system == nullptr || source_fd.load(std::memory_order_acquire) < 0) {
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		return;
	}

	spa_log_trace(log, "%p: request %p[%" PRIu64 "] completed status:%u seq:%" PRIu32,
			this, request, request->cookie(),
			static_cast<unsigned int>(request->status()),
			request->sequence());

	uint32_t index = 0;
	const int32_t used = spa_ringbuffer_get_write_index(&completed_requests_rb, &index);
	if (used < 0 || used >= COMPLETION_RING_SIZE) {
		spa_log_error(log, "completion ring overflow");
		request->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
		mark_completion_failure(this, -ENOSPC);
		return;
	}
	completed_requests[index & COMPLETION_RING_MASK] = request;
	spa_ringbuffer_write_update(&completed_requests_rb, index + 1);

	const int event_fd = source_fd.load(std::memory_order_acquire);
	if (event_fd < 0 || spa_system_eventfd_write(system, event_fd, 1) < 0) {
		const int error = event_fd < 0 ? -EIO : (errno ? -errno : -EIO);
		spa_log_error(log, "Failed to write on event fd: %s", spa_strerror(error));
		/* Keep the slot owned by the ring.  Advancing the read index here would
		 * discard older completions and leak their request ownership when the
		 * stream transitions to its terminal error state.  stop() drains every
		 * retained slot before resetting the ring. */
		mark_completion_failure(this, error);
	}

}

int spa_libcamera_stream_on(struct impl *impl)
{
	if (impl == nullptr || impl->camera == nullptr || impl->system == nullptr ||
		impl->data_loop == nullptr)
		return -EIO;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	struct port *port = &impl->out_ports[0];
	int res;

	if (!port->current_format) {
		spa_log_error(impl->log, "Exiting %s with -EIO", __FUNCTION__);
		return -EIO;
	}

	if (impl->active.load(std::memory_order_acquire))
		return 0;
	if (impl->requestPool.empty() || !impl->config || impl->config->empty())
		return -EIO;

	bool needs_cleanup;
	{
		std::lock_guard<std::mutex> lock(impl->completion_mutex);
		needs_cleanup = impl->camera_started.load(std::memory_order_acquire) ||
			impl->signal_connected.load(std::memory_order_acquire) ||
			impl->source_registered.load(std::memory_order_acquire) ||
			impl->source_fd.load(std::memory_order_acquire) >= 0 || impl->stopping;
	}
	/* A terminal completion deliberately leaves ownership intact for stop() to
	 * retire.  Never overwrite a registered source or live eventfd on restart. */
	if (needs_cleanup) {
		res = impl->stop();
		if (res < 0)
			return res;
		std::lock_guard<std::mutex> lock(impl->completion_mutex);
		if (impl->camera_started.load(std::memory_order_acquire) ||
			impl->signal_connected.load(std::memory_order_acquire) ||
			impl->source_registered.load(std::memory_order_acquire) ||
			impl->source_fd.load(std::memory_order_acquire) >= 0 || impl->stopping)
			return -EBUSY;
	}
	{
		std::lock_guard<std::mutex> lock(impl->completion_mutex);
		if (impl->stopping)
			return -EBUSY;
		impl->completion_error.store(0, std::memory_order_release);
	}

	spa_log_info(impl->log, "starting camera %s", impl->camera->id().c_str());
	res = spa_system_eventfd_create(impl->system, SPA_FD_CLOEXEC | SPA_FD_NONBLOCK);
	if (res < 0)
		goto err_stop;

	impl->source.fd = res;
	impl->source_fd.store(res, std::memory_order_release);
	impl->source.func = libcamera_on_fd_events;
	impl->source.data = impl;
	impl->source.mask = SPA_IO_IN | SPA_IO_ERR;
	impl->source.rmask = 0;

	/* Register the source before queueing requests so an immediately completed
	 * request has a live wakeup target. */
	res = spa_loop_invoke(
		impl->data_loop,
		camera_add_source_invoke,
		0, nullptr, 0, true, impl
	);
	if (res < 0)
		goto err_stop;
	if (!impl->source_registered.load(std::memory_order_acquire)) {
		res = -EIO;
		goto err_stop;
	}

	{
		/* start(), the initial request submission and stop() form one camera-I/O
		 * transaction.  A concurrent recycle cannot queue into a half-started
		 * camera, and stop() waits until the whole initial batch is settled. */
		std::lock_guard<std::mutex> camera_guard(impl->camera_io_mutex);
		spa_dll_init(&impl->dll);
		res = impl->camera->start(&impl->initial_controls);
		if (res >= 0) {
			impl->camera_started.store(true, std::memory_order_release);
			impl->camera->requestCompleted.connect(impl, &impl::requestComplete);
			impl->signal_connected.store(true, std::memory_order_release);
			impl->active.store(true, std::memory_order_release);

			for (auto& req : impl->requestPool) {
				req->reuse(libcamera::Request::ReuseFlag::ReuseBuffers);
				res = impl->camera->queueRequest(req.get());
				if (res < 0)
					break;
			}
		}
	}
	if (res < 0)
		goto err_stop;

	return 0;

err_stop:
	(void)impl->stop();

	return res;
}

int spa_libcamera_stream_off(struct impl *impl)
{
	if (impl == nullptr)
		return -EINVAL;
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	if (!impl->active.load(std::memory_order_acquire) &&
		!impl->camera_started.load(std::memory_order_acquire) &&
		!impl->source_registered.load(std::memory_order_acquire) &&
		impl->source_fd.load(std::memory_order_acquire) < 0)
		return 0;

	if (impl->camera)
		spa_log_info(impl->log, "stopping camera %s", impl->camera->id().c_str());

	return impl->stop();
}

int port_get_format(struct impl *impl, struct port *port,
		    uint32_t index,
		    const struct spa_pod *filter,
		    struct spa_pod **param,
		    struct spa_pod_builder *builder)
{
	struct spa_pod_frame f;

	if (!port->current_format)
		return -EIO;
	if (index > 0)
		return 0;
	struct spa_fraction rate = defaultFramerate;
	switch (port->current_format->media_subtype) {
	case SPA_MEDIA_SUBTYPE_raw:
		rate = normalized_framerate(&port->current_format->info.raw.framerate);
		break;
	case SPA_MEDIA_SUBTYPE_mjpg:
	case SPA_MEDIA_SUBTYPE_jpeg:
		rate = normalized_framerate(&port->current_format->info.mjpg.framerate);
		break;
	case SPA_MEDIA_SUBTYPE_h264:
		rate = normalized_framerate(&port->current_format->info.h264.framerate);
		break;
	default:
		return -EIO;
	}

	spa_pod_builder_push_object(builder, &f, SPA_TYPE_OBJECT_Format, SPA_PARAM_Format);
	spa_pod_builder_add(builder,
		SPA_FORMAT_mediaType,    SPA_POD_Id(port->current_format->media_type),
		SPA_FORMAT_mediaSubtype, SPA_POD_Id(port->current_format->media_subtype),
		0);

	switch (port->current_format->media_subtype) {
	case SPA_MEDIA_SUBTYPE_raw: {
		const auto &raw = port->current_format->info.raw;
		spa_pod_builder_add(builder,
			SPA_FORMAT_VIDEO_format,    SPA_POD_Id(raw.format),
			SPA_FORMAT_VIDEO_size,      SPA_POD_Rectangle(&raw.size),
			SPA_FORMAT_VIDEO_framerate, SPA_POD_Fraction(&rate),
			0);
		if (raw.flags & SPA_VIDEO_FLAG_MODIFIER) {
			spa_pod_builder_prop(builder, SPA_FORMAT_VIDEO_modifier, 0);
			spa_pod_builder_long(builder, raw.modifier);
		}
		if (raw.color_range != SPA_VIDEO_COLOR_RANGE_UNKNOWN ||
			raw.color_matrix != SPA_VIDEO_COLOR_MATRIX_UNKNOWN ||
			raw.transfer_function != SPA_VIDEO_TRANSFER_UNKNOWN ||
			raw.color_primaries != SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN) {
			spa_pod_builder_add(builder,
				SPA_FORMAT_VIDEO_colorRange, SPA_POD_Id(raw.color_range),
				SPA_FORMAT_VIDEO_colorMatrix, SPA_POD_Id(raw.color_matrix),
				SPA_FORMAT_VIDEO_transferFunction, SPA_POD_Id(raw.transfer_function),
				SPA_FORMAT_VIDEO_colorPrimaries, SPA_POD_Id(raw.color_primaries),
				0);
		}
		break;
	}
	case SPA_MEDIA_SUBTYPE_mjpg:
	case SPA_MEDIA_SUBTYPE_jpeg:
		spa_pod_builder_add(builder,
			SPA_FORMAT_VIDEO_size,      SPA_POD_Rectangle(&port->current_format->info.mjpg.size),
			SPA_FORMAT_VIDEO_framerate, SPA_POD_Fraction(&rate),
			0);
		break;
	case SPA_MEDIA_SUBTYPE_h264:
		spa_pod_builder_add(builder,
			SPA_FORMAT_VIDEO_size,      SPA_POD_Rectangle(&port->current_format->info.h264.size),
			SPA_FORMAT_VIDEO_framerate, SPA_POD_Fraction(&rate),
			0);
		break;
	default:
		return -EIO;
	}

	*param = (struct spa_pod*)spa_pod_builder_pop(builder, &f);

	return 1;
}

int impl_node_enum_params(void *object, int seq,
			  uint32_t id, uint32_t start, uint32_t num,
			  const struct spa_pod *filter)
{
	struct impl *impl = (struct impl*)object;
	struct spa_pod *param;
	struct spa_pod_builder b = { 0 };
	uint8_t buffer[1024];
	struct spa_result_node_params result;
	uint32_t count = 0;
	int res;

	spa_return_val_if_fail(impl != nullptr, -EINVAL);
	spa_return_val_if_fail(num != 0, -EINVAL);
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);

	result.id = id;
	result.next = start;
next:
	result.index = result.next++;

	spa_pod_builder_init(&b, buffer, sizeof(buffer));

	switch (id) {
	case SPA_PARAM_PropInfo:
	{
		switch (result.index) {
		default:
			return spa_libcamera_enum_controls(impl,
					GET_OUT_PORT(impl, 0),
					seq, result.index, 0, num, filter);
		}
		break;
	}
	case SPA_PARAM_Props:
	{
		switch (result.index) {
		default:
			return 0;
		}
		break;
	}
	case SPA_PARAM_EnumFormat:
		return spa_libcamera_enum_format(impl, GET_OUT_PORT(impl, 0),
				seq, start, num, filter);
	case SPA_PARAM_Format:
		if ((res = port_get_format(impl, GET_OUT_PORT(impl, 0), result.index, filter, &param, &b)) <= 0)
			return res;
		break;
	default:
		return -ENOENT;
	}

	if (spa_pod_filter(&b, &result.param, param, filter) < 0)
		goto next;

	spa_node_emit_result(&impl->hooks, seq, 0, SPA_RESULT_TYPE_NODE_PARAMS, &result);

	if (++count != num)
		goto next;

	return 0;
}

int impl_node_set_param(void *object,
			uint32_t id, uint32_t flags,
			const struct spa_pod *param)
{
	auto *impl = static_cast<struct impl *>(object);

	spa_return_val_if_fail(impl != nullptr, -EINVAL);
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	if (impl->camera == nullptr)
		return -EIO;

	switch (id) {
	case SPA_PARAM_Props:
	{
		if (param == nullptr)
			return 0;

		libcamera::ControlList controls(impl->camera->controls());
		int res = control_list_update_from_props_pod(controls, param,
			SPA_POD_SIZE(param));
		if (res < 0)
			return res;

		res = spa_libcamera_apply_controls(impl, std::move(controls));
		if (res < 0)
			return res;

		break;
	}
	default:
		return -ENOENT;
	}
	return 0;
}

int impl_node_set_io(void *object, uint32_t id, void *data, size_t size)
{
	struct impl *impl = (struct impl*)object;

	spa_return_val_if_fail(impl != nullptr, -EINVAL);
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);
	std::lock_guard<std::mutex> buffer_guard(impl->buffer_mutex);

	switch (id) {
	case SPA_IO_Clock:
		if (data != nullptr && size > std::numeric_limits<uint32_t>::max())
			return -EOVERFLOW;
		if (data != nullptr && size < sizeof(struct spa_io_clock))
			return -ENOSPC;
		if (!naturally_aligned<struct spa_io_clock>(data))
			return -EINVAL;
		if (const int io_res = validate_io_registration_locked(impl,
				&impl->out_ports[0], registered_io_slot::clock, data,
				data != nullptr ? size : 0, alignof(struct spa_io_clock));
			io_res < 0)
			return io_res;
		impl->clock = (struct spa_io_clock*)data;
		impl->clock_size = data != nullptr ? size : 0;
		break;
	case SPA_IO_Position:
		if (data != nullptr && size > std::numeric_limits<uint32_t>::max())
			return -EOVERFLOW;
		if (data != nullptr && size < sizeof(struct spa_io_position))
			return -ENOSPC;
		if (!naturally_aligned<struct spa_io_position>(data))
			return -EINVAL;
		if (const int io_res = validate_io_registration_locked(impl,
				&impl->out_ports[0], registered_io_slot::position, data,
				data != nullptr ? size : 0, alignof(struct spa_io_position));
			io_res < 0)
			return io_res;
		impl->position = (struct spa_io_position*)data;
		impl->position_size = data != nullptr ? size : 0;
		break;
	default:
		return -ENOENT;
	}
	return 0;
}

int impl_node_send_command(void *object, const struct spa_command *command)
{
	struct impl *impl = (struct impl*)object;
	int res;

	spa_return_val_if_fail(impl != nullptr, -EINVAL);
	spa_return_val_if_fail(command != nullptr, -EINVAL);
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);

	switch (SPA_NODE_COMMAND_ID(command)) {
	case SPA_NODE_COMMAND_Start:
	{
		struct port *port = GET_OUT_PORT(impl, 0);

		if (!port->current_format)
			return -EIO;
		if (port->n_buffers == 0)
			return -EIO;

		if ((res = spa_libcamera_stream_on(impl)) < 0)
			return res;
		break;
	}
	case SPA_NODE_COMMAND_Pause:
	case SPA_NODE_COMMAND_Suspend:
		if ((res = spa_libcamera_stream_off(impl)) < 0)
			return res;
		break;
	default:
		return -ENOTSUP;
	}

	return 0;
}

void emit_node_info(struct impl *impl, bool full)
{
	static const struct spa_dict_item info_items[] = {
		{ SPA_KEY_DEVICE_API, "libcamera" },
		{ SPA_KEY_MEDIA_CLASS, "Video/Source" },
		{ SPA_KEY_MEDIA_ROLE, "Camera" },
		{ SPA_KEY_NODE_DRIVER, "true" },
	};
	uint64_t old = full ? impl->info.change_mask : 0;
	if (full)
		impl->info.change_mask = impl->info_all;
	if (impl->info.change_mask) {
		struct spa_dict dict = SPA_DICT_INIT_ARRAY(info_items);
		impl->info.props = &dict;
		spa_node_emit_info(&impl->hooks, &impl->info);
		impl->info.change_mask = old;
	}
}

void emit_port_info(struct impl *impl, struct port *port, bool full)
{
	uint64_t old = full ? port->info.change_mask : 0;
	if (full)
		port->info.change_mask = port->info_all;
	if (port->info.change_mask) {
		spa_node_emit_port_info(&impl->hooks,
				SPA_DIRECTION_OUTPUT, 0, &port->info);
		port->info.change_mask = old;
	}
}

int
impl_node_add_listener(void *object,
		struct spa_hook *listener,
		const struct spa_node_events *events,
		void *data)
{
	struct impl *impl = (struct impl*)object;
	struct spa_hook_list save;

	spa_return_val_if_fail(impl != nullptr, -EINVAL);
	std::lock_guard<std::recursive_mutex> lifecycle_guard(impl->lifecycle_mutex);

	spa_hook_list_isolate(&impl->hooks, &save, listener, events, data);

	emit_node_info(impl, true);
	emit_port_info(impl, GET_OUT_PORT(impl, 0), true);

	spa_hook_list_join(&impl->hooks, &save);

	return 0;
}

